@model BookingStats

<sa-card>
    <sa-card-header>
        <sa-card-title>Bookings</sa-card-title>
        <sa-card-description>Made this month</sa-card-description>
    </sa-card-header>
    <sa-card-content>
        <p class="tabular-nums" style="font-size: 1.5rem; font-weight: 600">@Model.Count</p>
    </sa-card-content>
</sa-card>

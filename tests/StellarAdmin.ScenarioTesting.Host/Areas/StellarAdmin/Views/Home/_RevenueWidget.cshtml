@model Revenue

<sa-card>
    <sa-card-header>
        <sa-card-title>Revenue</sa-card-title>
        <sa-card-description>From bookings made in the period</sa-card-description>
        <sa-card-action>
            <sa-widget-form>
                <sa-select name="Days" size="SelectSize.Small" aria-label="Period">
                    <option value="30" selected="@(Model.Days == 30)">30 days</option>
                    <option value="90" selected="@(Model.Days == 90)">90 days</option>
                </sa-select>
            </sa-widget-form>
        </sa-card-action>
    </sa-card-header>
    <sa-card-content>
        <p class="tabular-nums" style="font-size: 1.5rem; font-weight: 600">@Model.Total.ToString("C0")</p>
    </sa-card-content>
</sa-card>

@using StellarAdmin.Resources
@model ResourceDataLayoutModel<StellarAdmin.IntegrationTests.Fixtures.ProductTotal>
<a data-test="index-url" href="@Model.GetIndexUrl(new { layout = "products" })">Products</a>
@foreach (var total in Model.Items)
{
    <p data-test="total" data-view="@(Model.GetViewUrl(total) ?? "none")">@total.Layout/@total.Scope/@(total.Search ?? "none")/@total.Products</p>
}

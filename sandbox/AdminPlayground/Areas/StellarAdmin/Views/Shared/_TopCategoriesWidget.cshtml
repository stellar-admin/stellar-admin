@model TopCategories
<sa-card>
    <sa-card-header>
        <sa-card-title>Top categories</sa-card-title>
        <sa-card-description>By number of products</sa-card-description>
        <sa-card-action>
            <sa-widget-form>
                <sa-select name="Count" size="SelectSize.Small" aria-label="Categories to show">
                    <option value="3" selected="@(Model.Count == 3)">Top 3</option>
                    <option value="5" selected="@(Model.Count == 5)">Top 5</option>
                    <option value="10" selected="@(Model.Count == 10)">Top 10</option>
                </sa-select>
            </sa-widget-form>
        </sa-card-action>
    </sa-card-header>
    <sa-card-content>
        @if (Model.Categories.Count == 0)
        {
            <p class="text-sm text-muted-foreground">No products have a category yet.</p>
        }
        else
        {
            <ol class="flex flex-col gap-2 text-sm">
                @foreach (var category in Model.Categories)
                {
                    <li class="flex items-center justify-between gap-4">
                        <span>@category.Name</span>
                        <sa-badge variant="BadgeVariant.Secondary">@category.Products</sa-badge>
                    </li>
                }
            </ol>
        }
    </sa-card-content>
</sa-card>

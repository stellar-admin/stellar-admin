@using StellarAdmin.Resources
@model ResourceLayoutModel<CategoryPriceSummary>
@* The prices per category of the products the scope and search select, from CategoryPriceSummaryHandler *@
@if (Model.Items.Count == 0)
{
    <p class="text-sm text-muted-foreground">No products match.</p>
}
else
{
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        @foreach (var summary in Model.Items)
        {
            <sa-card size="CardSize.Small">
                <sa-card-header>
                    <sa-card-title>
                        @if (Model.GetViewUrl(summary) is { } viewUrl)
                        {
                            <a class="underline-offset-4 hover:underline" href="@viewUrl">@summary.Category</a>
                        }
                        else
                        {
                            @summary.Category
                        }
                    </sa-card-title>
                    <sa-card-description>@summary.Products @(summary.Products == 1 ? "product" : "products")</sa-card-description>
                </sa-card-header>
                <sa-card-content>
                    <dl class="flex flex-col gap-2 text-sm">
                        <div class="flex items-center justify-between gap-4">
                            <dt class="text-muted-foreground">Lowest</dt>
                            <dd class="tabular-nums">@summary.Lowest.ToString("0.00")</dd>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                            <dt class="text-muted-foreground">Average</dt>
                            <dd class="tabular-nums">@summary.Average.ToString("0.00")</dd>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                            <dt class="text-muted-foreground">Highest</dt>
                            <dd class="tabular-nums">@summary.Highest.ToString("0.00")</dd>
                        </div>
                    </dl>
                </sa-card-content>
            </sa-card>
        }
    </div>
    <p class="mt-4 text-sm text-muted-foreground">
        <a class="underline underline-offset-4" href="@Model.GetIndexUrl(new { layout = "catalog" })">List these products</a>
    </p>
}

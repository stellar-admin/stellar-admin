@model CatalogStats
<sa-card>
    <sa-card-header>
        <sa-card-title>Catalog</sa-card-title>
        <sa-card-description>What Voyager sells today</sa-card-description>
    </sa-card-header>
    <sa-card-content>
        <dl class="grid grid-cols-3 gap-4">
            <div class="flex flex-col gap-1">
                <dt class="text-sm text-muted-foreground">Products</dt>
                <dd class="text-2xl font-semibold tabular-nums">@Model.Products</dd>
            </div>
            <div class="flex flex-col gap-1">
                <dt class="text-sm text-muted-foreground">Categories</dt>
                <dd class="text-2xl font-semibold tabular-nums">@Model.Categories</dd>
            </div>
            <div class="flex flex-col gap-1">
                <dt class="text-sm text-muted-foreground">Average price</dt>
                <dd class="text-2xl font-semibold tabular-nums">@Model.AveragePrice.ToString("0.00")</dd>
            </div>
        </dl>
    </sa-card-content>
</sa-card>

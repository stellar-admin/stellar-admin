<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="wwwroot\css\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\StellarAdmin.UI\StellarAdmin.UI.csproj" />
  </ItemGroup>
  <!-- The theme picker's themes: the reader DocsSamples and the docs export share. -->
  <ItemGroup>
    <Compile Include="..\..\docs\DocsSamples\ThemeFixtures.cs" Link="ThemeFixtures.cs" />
  </ItemGroup>
  <!--
    The layout links _content/StellarAdmin.UI/stellar-admin.css (and a theme fixture from
    /presets/), and this Tailwind build covers only the app's own markup, importing the StellarAdmin
    Tailwind adapter so token-named utilities (bg-primary, …) resolve to the tokens.
  -->
  <Import Project="../../build/Client.targets" />

  <ItemGroup>
    <ClientInput Include="Client/css/**/*.css" />
    <ClientInput Include="../../src/StellarAdmin.UI/Client/css/tailwind-adapter.css" />
    <ClientInput Include="Client/package.json" />
  </ItemGroup>

  <!-- Declared at execution time, as in StellarAdmin: .cshtml files in a second item type break
       Rider's Razor analysis. Tailwind scans the Pages folder. -->
  <Target Name="ClientItems">
    <ItemGroup>
      <ClientInput Include="Pages/**/*.cshtml;Pages/**/*.cs" />

      <ClientOutput Include="wwwroot/css/site.css" />
    </ItemGroup>
  </Target>
</Project>

@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var pageTitle = DemoNavigation.Groups.SelectMany(group => group.Items).FirstOrDefault(item => item.Page == currentPage)?.Title
                    ?? ViewData["Title"] as string;
    // The theme picker: a theme fixture (util/theme-check/presets) linked after stellar-admin.css
    // (?theme=ledger); the default theme has none.
    var presets = new Dictionary<string, string>
    {
        ["default"] = "Inter:wght@400..700",
        ["ledger"] = "Lexend:wght@300..700",
        ["ops"] = "IBM+Plex+Sans:wght@400;500;600;700",
        ["soft"] = "Figtree:wght@400..700",
    };
    var theme = Context.Request.Query["theme"].ToString();
    if (!presets.ContainsKey(theme)) { theme = "default"; }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@pageTitle - ComponentPlayground</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link rel="stylesheet" href="@($"https://fonts.googleapis.com/css2?family={presets[theme]}&display=swap")"/>
    <!-- stellar-admin.css and the theme for the components, site.css for this app's own markup. -->
    <link rel="stylesheet" href="/_content/StellarAdmin.TagHelpers/stellar-admin.css" asp-append-version="true"/>
    @if (theme != "default")
    {
        <link rel="stylesheet" href="@($"/presets/{theme}.css")" asp-append-version="true"/>
    }
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true"/>
    <script defer src="/_content/StellarAdmin.TagHelpers/stellar-admin.js" asp-append-version="true"></script>
</head>
<body>
<sa-sidebar-wrapper>
    <sa-sidebar>
        <sa-sidebar-header>
            <sa-sidebar-menu>
                <sa-sidebar-menu-item>
                    <sa-sidebar-menu-link asp-page="/Index" size="SidebarMenuLinkSize.Large">
                        <div
                            class="flex aspect-square size-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                            <sa-icon name="blocks"/>
                        </div>
                        <div class="grid flex-1 text-left text-sm leading-tight">
                            <span class="truncate font-semibold">Component Playground</span>
                            <span class="truncate text-xs text-muted-foreground">StellarAdmin</span>
                        </div>
                    </sa-sidebar-menu-link>
                </sa-sidebar-menu-item>
            </sa-sidebar-menu>
            <sa-button variant="ButtonVariant.Outline" commandfor="playground-command" command="show-modal"
                       class="w-full justify-between text-muted-foreground">
                <span class="flex items-center gap-2">
                    <sa-icon name="search" aria-hidden="true"/>
                    Search demos...
                </span>
                <sa-kbd-group id="playground-command-shortcut" aria-hidden="true">
                    <sa-kbd>Ctrl</sa-kbd>
                    <sa-kbd>K</sa-kbd>
                </sa-kbd-group>
            </sa-button>
        </sa-sidebar-header>
        <sa-sidebar-content>
            @foreach (var demoGroup in DemoNavigation.Groups)
            {
                <sa-sidebar-group>
                    <sa-sidebar-group-label>@demoGroup.Title</sa-sidebar-group-label>
                    <sa-sidebar-group-content>
                        <sa-sidebar-menu>
                            @foreach (var demoItem in demoGroup.Items)
                            {
                                <sa-sidebar-menu-item>
                                    <sa-sidebar-menu-link asp-page="@demoItem.Page">
                                        @demoItem.Title
                                    </sa-sidebar-menu-link>
                                </sa-sidebar-menu-item>
                            }
                        </sa-sidebar-menu>
                    </sa-sidebar-group-content>
                </sa-sidebar-group>
            }
        </sa-sidebar-content>
        <sa-sidebar-footer>
            <sa-sidebar-group>
                <sa-sidebar-group-label>Theme</sa-sidebar-group-label>
                <sa-sidebar-group-content>
                    <sa-sidebar-menu>
                        @foreach (var preset in presets.Keys)
                        {
                            var label = char.ToUpperInvariant(preset[0]) + preset[1..];
                            <sa-sidebar-menu-item>
                                @if (preset == theme)
                                {
                                    <sa-sidebar-menu-link href="@($"{Context.Request.Path}?theme={preset}")" data-active="">@label</sa-sidebar-menu-link>
                                }
                                else
                                {
                                    <sa-sidebar-menu-link href="@($"{Context.Request.Path}?theme={preset}")">@label</sa-sidebar-menu-link>
                                }
                            </sa-sidebar-menu-item>
                        }
                    </sa-sidebar-menu>
                </sa-sidebar-group-content>
            </sa-sidebar-group>
        </sa-sidebar-footer>
    </sa-sidebar>
    <sa-sidebar-inset>
        <sa-app-header>
            <sa-sidebar-trigger/>
            <sa-app-header-separator/>
            <span class="text-sm font-medium">@pageTitle</span>
        </sa-app-header>
        <div class="flex-1 p-8">
            @RenderBody()
        </div>
    </sa-sidebar-inset>
</sa-sidebar-wrapper>

<sa-command-dialog id="playground-command" title="Search demos" description="Search for a demo page to open.">
    <sa-command>
        <sa-command-input placeholder="Search demos..."/>
        <sa-command-list>
            <sa-command-empty>No demos found.</sa-command-empty>
            @foreach (var demoGroup in DemoNavigation.Groups)
            {
                <sa-command-group heading="@demoGroup.Title">
                    @foreach (var demoItem in demoGroup.Items)
                    {
                        <sa-command-link-item asp-page="@demoItem.Page" keywords="@demoGroup.Title"
                                              checked="@(demoItem.Page == currentPage)">
                            @demoItem.Title
                        </sa-command-link-item>
                    }
                </sa-command-group>
            }
        </sa-command-list>
    </sa-command>
</sa-command-dialog>
<sa-toaster />
<script src="/js/command-palette.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>

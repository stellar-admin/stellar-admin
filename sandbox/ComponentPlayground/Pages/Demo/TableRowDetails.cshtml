@page
@model ComponentPlayground.Pages.Demo.TableRowDetails

@*
    Row details with htmx. The first table's settings come from the query string
    (?emphasis=Rail&inset=Bleed&mode=Single&animate=false&rowClick=true). Rows load their details
    on first expand; the buttons replace or append rows to check that htmx-inserted rows work
    without re-initialization. The event log lists every row-detail-expand/-collapse.
*@

<div class="flex max-w-5xl flex-col gap-10 p-10">
    <div class="flex flex-col gap-1">
        <h1 class="text-2xl font-semibold">Table row details</h1>
        <p class="text-sm text-muted-foreground">
            Emphasis @Model.Emphasis, inset @Model.Inset, mode @Model.Mode, animate @Model.Animate, row click @Model.RowClick.
        </p>
    </div>

    <section class="flex flex-col gap-3">
        <div class="flex items-center gap-2">
            <h2 class="text-lg font-semibold">Leading toggle, details loaded with htmx</h2>
            <sa-button variant="ButtonVariant.Outline" size="ButtonSize.Small" class="ml-auto"
                       id="reload-rows" hx-get="?handler=Rows" hx-target="#bookings-body" hx-swap="innerHTML">
                Reload rows
            </sa-button>
            <sa-button variant="ButtonVariant.Outline" size="ButtonSize.Small"
                       id="append-rows" hx-get="?handler=More" hx-target="#bookings-body" hx-swap="beforeend">
                Add rows
            </sa-button>
        </div>
        <div class="rounded-lg border">
            <sa-table-row-details id="bookings" emphasis="Model.Emphasis" inset="Model.Inset" expand-mode="Model.Mode"
                                  animate="Model.Animate" row-click="Model.RowClick">
                <sa-table>
                    <sa-table-header>
                        <sa-table-row>
                            <sa-table-head class="w-px"><sa-table-row-detail-toggle all="true" /></sa-table-head>
                            <sa-table-head>Reference</sa-table-head>
                            <sa-table-head>Lead traveller</sa-table-head>
                            <sa-table-head>Destination</sa-table-head>
                            <sa-table-head>Status</sa-table-head>
                            <sa-table-head class="text-right">Total</sa-table-head>
                        </sa-table-row>
                    </sa-table-header>
                    <sa-table-body id="bookings-body">
                        <partial name="_TableRowDetailsRows" model="Model.Rows" />
                    </sa-table-body>
                </sa-table>
            </sa-table-row-details>
        </div>
        <ol id="event-log" class="flex flex-col gap-1 font-mono text-xs text-muted-foreground"></ol>
    </section>

    <section class="flex flex-col gap-3">
        <h2 class="text-lg font-semibold">Trailing toggle, row click, one open, rail, bleed</h2>
        <div class="rounded-lg border">
            <sa-table-row-details id="trailing" row-click="true" expand-mode="TableRowDetailExpandMode.Single"
                                  emphasis="TableRowDetailEmphasis.Rail" inset="TableRowDetailInset.Bleed">
                <sa-table>
                    <sa-table-header>
                        <sa-table-row>
                            <sa-table-head>Reference</sa-table-head>
                            <sa-table-head>Lead traveller</sa-table-head>
                            <sa-table-head>Destination</sa-table-head>
                            <sa-table-head class="w-px"></sa-table-head>
                        </sa-table-row>
                    </sa-table-header>
                    <sa-table-body>
                        @foreach (var booking in Model.AllBookings.Take(3))
                        {
                            <sa-table-row>
                                <sa-table-cell class="font-medium">@booking.Reference</sa-table-cell>
                                <sa-table-cell>@booking.Lead</sa-table-cell>
                                <sa-table-cell>@booking.Destination</sa-table-cell>
                                <sa-table-cell class="w-px whitespace-nowrap">
                                    <sa-linkbutton variant="ButtonVariant.Outline" size="ButtonSize.IconSmall" href="#" aria-label="Edit @booking.Reference">
                                        <sa-icon name="square-pen" />
                                    </sa-linkbutton>
                                    <sa-table-row-detail-toggle aria-label="Toggle details for @booking.Reference" />
                                </sa-table-cell>
                            </sa-table-row>
                            @* htmx attributes on the detail row itself: the event fires there, so no from: is needed. *@
                            <sa-table-row-detail hx-get="?handler=Details&id=@booking.Id" hx-trigger="row-detail-expand once"
                                                 hx-target="find [data-slot=table-row-detail-content]">
                                <div class="flex flex-col gap-2" aria-busy="true">
                                    <sa-skeleton class="h-4 w-1/3" />
                                    <sa-skeleton class="h-4 w-2/3" />
                                </div>
                            </sa-table-row-detail>
                        }
                    </sa-table-body>
                </sa-table>
            </sa-table-row-details>
        </div>
    </section>

    <section class="flex flex-col gap-3">
        <h2 class="text-lg font-semibold">Data grid: selection, leading toggle, nested grid, expanded-keys</h2>
        <sa-data-grid id="grid-bookings" items="Model.AllBookings">
            <sa-data-grid-selection key-field="Id" name="selected" />
            <sa-data-grid-column title="Reference" field="Reference" />
            <sa-data-grid-column title="Lead traveller" field="Lead" />
            <sa-data-grid-column title="Destination" field="Destination" />
            <sa-data-grid-column title="Total" field="Total" />
            <sa-data-grid-row-detail key-field="Id" expanded-keys="new[] { 24830 }">
                @{ var booking = Html.GridItem<RowDetailBooking>(); }
                <div class="flex flex-col gap-3">
                    <label class="flex items-center gap-2 text-sm">
                        <sa-input type="checkbox" name="insured-@booking.Id" />
                        Travel insurance confirmed for @booking.Reference
                    </label>
                    <sa-data-grid items="TableRowDetails.SegmentsFor(booking)">
                        <sa-data-grid-column title="Type" field="Type" />
                        <sa-data-grid-column title="Date" field="Date" />
                        <sa-data-grid-column title="Description" field="Description" />
                        <sa-data-grid-column title="Amount" field="Amount" />
                    </sa-data-grid>
                </div>
            </sa-data-grid-row-detail>
        </sa-data-grid>
    </section>

    <section class="flex flex-col gap-3">
        <h2 class="text-lg font-semibold">Data grid: toggle in the actions column (toggle=None), row click, single, rail</h2>
        <sa-data-grid id="grid-actions" items="Model.AllBookings">
            <sa-data-grid-column title="Reference" field="Reference" />
            <sa-data-grid-column title="Lead traveller" field="Lead" />
            <sa-data-grid-column title="Destination" field="Destination" />
            <sa-data-grid-column class="w-px whitespace-nowrap">
                <sa-data-grid-item-template>
                    @{ var booking = Html.GridItem<RowDetailBooking>(); }
                    <sa-linkbutton variant="ButtonVariant.Outline" size="ButtonSize.IconSmall" href="#" aria-label="Edit @booking.Reference">
                        <sa-icon name="square-pen" />
                    </sa-linkbutton>
                    <sa-table-row-detail-toggle aria-label="Toggle details for @booking.Reference" />
                </sa-data-grid-item-template>
            </sa-data-grid-column>
            <sa-data-grid-row-detail toggle="DataGridRowDetailToggle.None" row-click="true"
                                     expand-mode="TableRowDetailExpandMode.Single" emphasis="TableRowDetailEmphasis.Rail">
                <partial name="_TableRowDetailsBooking" model="Html.GridItem<RowDetailBooking>()" />
            </sa-data-grid-row-detail>
        </sa-data-grid>
    </section>
</div>

@section Scripts {
    <script src="/js/htmx.min.js"></script>
    <script>
        const log = document.getElementById("event-log");
        for (const type of ["row-detail-expand", "row-detail-collapse"]) {
            document.addEventListener(type, (event) => {
                const item = document.createElement("li");
                item.textContent = `${type} ${event.target.id} (row: ${event.detail.row?.cells[1]?.textContent.trim()})`;
                log.prepend(item);
            });
        }
    </script>
}

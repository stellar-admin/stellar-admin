@page
@model ComponentPlayground.Pages.Demo.InputOTP

<sa-container class="py-6 lg:py-8">
    <sa-stack>
        <h2 class="bg-gray-100 text-base font-bold">Unbound</h2>
        <sa-input-otp max-length="6"/>

        <h2 class="bg-gray-100 text-base font-bold">Grouped (3,3)</h2>
        <sa-input-otp max-length="6" groups="3,3"/>

        <h2 class="bg-gray-100 text-base font-bold">Composition</h2>
        <sa-input-otp max-length="4">
            <sa-input-otp-group>
                <sa-input-otp-slot/>
                <sa-input-otp-slot/>
            </sa-input-otp-group>
            <sa-input-otp-separator/>
            <sa-input-otp-group>
                <sa-input-otp-slot/>
                <sa-input-otp-slot/>
            </sa-input-otp-group>
        </sa-input-otp>

        <h2 class="bg-gray-100 text-base font-bold">Disabled</h2>
        <sa-input-otp max-length="6" value="123" disabled="true"/>

        <h2 class="bg-gray-100 text-base font-bold">Model binding + validation</h2>
        <form method="post" class="flex w-full max-w-md flex-col gap-6">
            <sa-input-otp asp-for="Model.VerificationCode" groups="3,3"/>
            <sa-button type="submit">Submit</sa-button>
        </form>

        @if (Model.Posted)
        {
            <div class="w-full max-w-md rounded-md border border-green-600 bg-green-50 p-4 text-sm">
                <p class="font-bold">Posted values</p>
                <p>VerificationCode = <code>@Model.Model.VerificationCode</code></p>
            </div>
        }
    </sa-stack>
</sa-container>

@section Scripts {
    <script src="/_content/StellarAdmin.TagHelpers/stellar-admin.js" asp-append-version="true"></script>
}

@page
@model ComponentPlayground.Pages.Demo.Slider

<sa-page-container class="py-6 lg:py-8">
    <sa-stack>
        <form method="post" class="flex w-full max-w-md flex-col gap-8">
            <div class="flex flex-col gap-3">
                <h2 class="bg-gray-100 text-base font-bold">Single slider</h2>
                <sa-slider asp-for="Model.Volume" min="0" max="100"/>
            </div>
            <div class="flex flex-col gap-3">
                <h2 class="bg-gray-100 text-base font-bold">Range slider</h2>
                <sa-slider asp-for="Model.PriceRange" min="0" max="1000" step="50" min-distance="50"/>
            </div>
            <sa-button type="submit">Submit</sa-button>
        </form>

        @if (Model.Posted)
        {
            <div class="w-full max-w-md rounded-md border border-green-600 bg-green-50 p-4 text-sm">
                <p class="font-bold">Posted values</p>
                <p>Volume = <code>@Model.Model.Volume</code></p>
                <p>PriceRange = <code>[@string.Join(", ", Model.Model.PriceRange)]</code></p>
            </div>
        }
    </sa-stack>
</sa-page-container>

@section Scripts {
    <script src="/_content/StellarAdmin.TagHelpers/stellar-admin.js" asp-append-version="true"></script>
}

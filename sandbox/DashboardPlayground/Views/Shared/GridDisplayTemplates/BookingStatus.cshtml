@using DashboardPlayground.Resources.FormLayouts
@using StellarAdmin.TagHelpers
@addTagHelper *, StellarAdmin.TagHelpers
@model GalleryBookingStatus

@* The index cell for [UIHint("BookingStatus")]: a grid display template beside the display template *@
@{
    var variant = Model switch
    {
        GalleryBookingStatus.Confirmed => BadgeVariant.Default,
        GalleryBookingStatus.Cancelled => BadgeVariant.Destructive,
        _ => BadgeVariant.Secondary,
    };
}

<sa-badge variant="@variant">@Model</sa-badge>

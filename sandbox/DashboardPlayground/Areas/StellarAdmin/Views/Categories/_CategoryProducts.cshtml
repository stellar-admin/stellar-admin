@model CategoryProducts
@if (Model.Count == 0)
{
    <p class="text-sm text-muted-foreground">No products in this category.</p>
}
else
{
    <div class="flex flex-col gap-2">
        <p class="text-sm text-muted-foreground">
            @(Model.Count == 1 ? "1 product" : $"{Model.Count} products")@(Model.Count > Model.Products.Count ? $", the first {Model.Products.Count} by name" : "")
        </p>
        <sa-data-grid items="Model.Products">
            <sa-data-grid-column title="Product" field="Name" class="font-medium" />
            <sa-data-grid-column title="SKU" field="Sku" />
            <sa-data-grid-column title="Unit price" field="Price" format="{0:0.00}" class="text-right" />
        </sa-data-grid>
    </div>
}

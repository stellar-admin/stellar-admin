<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <_ContentIncludedByDefault Remove="Pages\AsChild\Index.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\AsChild\_Step1.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\AsChild\_Step2.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\AsChild\_Step3.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\AsChild\_Step4.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\AsChild\_Step5.cshtml" />
    <_ContentIncludedByDefault Remove="Pages\AsChild\_Step6.cshtml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\StellarAdmin.UI\StellarAdmin.UI.csproj" />
  </ItemGroup>

  <!-- Client -->
  <Import Project="../../build/Client.targets" />

  <ItemGroup>
    <ClientInput Include="Client/css/**/*.css" />
    <ClientInput Include="../../src/StellarAdmin.UI/Client/css/tailwind-adapter.css" />
    <ClientInput Include="Client/package.json" />
  </ItemGroup>

  <!-- Declared at execution time, as in StellarAdmin: .cshtml files in a second item type break
       Rider's Razor analysis. Tailwind scans the Pages and TagHelpers folders. -->
  <Target Name="ClientItems">
    <ItemGroup>
      <ClientInput Include="Pages/**/*.cshtml;Pages/**/*.cs;TagHelpers/**/*.cs" />

      <ClientOutput Include="wwwroot/css/site.css" />
    </ItemGroup>
  </Target>
</Project>

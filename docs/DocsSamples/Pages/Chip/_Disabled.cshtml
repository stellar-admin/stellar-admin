<div class="w-full max-w-md">
    <!-- code begin -->
    <sa-field>
        <sa-field-title id="locked-destinations-label">Destinations</sa-field-title>
        <sa-chip-group appearance="ChipGroupAppearance.Input" disabled="true" aria-labelledby="locked-destinations-label">
            <sa-chip>
                <code>LIS</code>
                Lisbon
                <sa-chip-remove aria-label="Remove Lisbon"/>
            </sa-chip>
            <sa-chip>
                <code>KIX</code>
                Kyoto
                <sa-chip-remove aria-label="Remove Kyoto"/>
            </sa-chip>
        </sa-chip-group>
        <sa-field-description>
            Destinations can't change once the itinerary is ticketed.
        </sa-field-description>
    </sa-field>
    <!-- code end -->
</div>

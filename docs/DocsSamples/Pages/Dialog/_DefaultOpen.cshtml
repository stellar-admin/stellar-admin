<div class="min-h-[450px]">
    <!-- code begin -->
    <sa-button variant="ButtonVariant.Outline" commandfor="--dialog-default-open" command="show-modal">
        Open
    </sa-button>
    <sa-dialog id="--dialog-default-open" open>
        <sa-dialog-header>
            <sa-dialog-title>Default Open</sa-dialog-title>
        </sa-dialog-header>
        This dialog is open by default.
        <sa-dialog-footer>
            <sa-button variant="ButtonVariant.Outline" commandfor="--dialog-default-open" command="close">
                Close
            </sa-button>
        </sa-dialog-footer>
    </sa-dialog>
    <!-- code end -->
</div>

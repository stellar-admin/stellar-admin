<div class="w-full max-w-2xl">
    <!-- code begin -->
    <sa-checkbox-group name="columns-checkbox" label="Trip extras" columns-sm="2" columns-lg="3"
        flow="CheckboxGroupFlow.Down" values="@(["lounge", "transfer"])">
        <sa-checkbox-group-item value="wifi">Wi-Fi on board</sa-checkbox-group-item>
        <sa-checkbox-group-item value="lounge">Lounge access</sa-checkbox-group-item>
        <sa-checkbox-group-item value="priority">Priority boarding</sa-checkbox-group-item>
        <sa-checkbox-group-item value="baggage">Extra baggage</sa-checkbox-group-item>
        <sa-checkbox-group-item value="seat">Seat selection</sa-checkbox-group-item>
        <sa-checkbox-group-item value="insurance">Travel insurance</sa-checkbox-group-item>
        <sa-checkbox-group-item value="transfer">Airport transfer</sa-checkbox-group-item>
    </sa-checkbox-group>
    <!-- code end -->
</div>

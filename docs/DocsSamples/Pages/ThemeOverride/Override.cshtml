@page
@model DocsSamples.Pages.ThemeOverride.Override

<partial name="_ThemeOverride"/>

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400..700&display=swap" rel="stylesheet">
    <style>
        @@layer sa.theme {
            :root {
                --sa-accent: oklch(0.6725 0.1362 42);
                --sa-neutral-hue: 85;
                --sa-neutral-chroma: 0.012;
                --sa-radius: 2px;
                --sa-elevation: 0.3;
                --sa-font-sans: "JetBrains Mono", ui-monospace, monospace;
                --sa-font-mono: "JetBrains Mono", ui-monospace, monospace;
            }
        }
    </style>
}
@model Index.ShortcutsModel

<div class="w-full max-w-md">
    <!-- code begin -->
    <form method="post">
        <sa-questionnaire>
            <sa-questionnaire-item required="true">
                <sa-questionnaire-title>When would you like to depart?</sa-questionnaire-title>
                <sa-questionnaire-description>
                    Departure dates change the fare more than anything else.
                </sa-questionnaire-description>
                <sa-questionnaire-choices shortcuts="QuestionnaireShortcuts.Letters">
                    <sa-questionnaire-choice asp-for="Departure" value="asap">
                        As soon as possible
                    </sa-questionnaire-choice>
                    <sa-questionnaire-choice asp-for="Departure" value="shoulder">
                        Shoulder season
                    </sa-questionnaire-choice>
                    <sa-questionnaire-choice asp-for="Departure" value="flexible">
                        I am flexible
                    </sa-questionnaire-choice>
                </sa-questionnaire-choices>
            </sa-questionnaire-item>
        </sa-questionnaire>
    </form>
    <!-- code end -->
</div>

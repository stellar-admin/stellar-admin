<div class="flex w-full max-w-md flex-col gap-8">
    <!-- code begin -->
    <sa-slider value="200,800" max="1000" step="50" value-format="${0}">
        <sa-slider-marks interval="250" labels="SliderMarkLabels.Ends"/>
    </sa-slider>
    <sa-slider value="4" min="1" max="8">
        <sa-slider-marks labels="SliderMarkLabels.All"/>
    </sa-slider>
    <sa-slider value="40" max="100" value-format="{0} km">
        <sa-slider-marks labels="SliderMarkLabels.Ends" show-ticks="false"/>
    </sa-slider>
    <!-- code end -->
</div>

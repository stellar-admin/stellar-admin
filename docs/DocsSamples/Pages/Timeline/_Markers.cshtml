<div class="w-full max-w-lg">
    <!-- code begin -->
    <sa-timeline>
        <sa-timeline-item title="No media" description="A plain event: a dot."/>
        <sa-timeline-item title="An icon" description="On a sunken disc, in the muted ink.">
            <sa-timeline-item-media><sa-icon name="mail"/></sa-timeline-item-media>
        </sa-timeline-item>
        <sa-timeline-item title="A coloured icon with a label" description="The label is read before the title.">
            <sa-timeline-item-media label="Needs attention">
                <sa-icon name="triangle-alert" class="text-[var(--sa-color-warning)]"/>
            </sa-timeline-item-media>
        </sa-timeline-item>
        <sa-timeline-item title="An avatar" description="Fills the marker.">
            <sa-timeline-item-media><sa-avatar name="Amara Okafor" size="AvatarSize.Small"/></sa-timeline-item-media>
        </sa-timeline-item>
    </sa-timeline>
    <!-- code end -->
</div>

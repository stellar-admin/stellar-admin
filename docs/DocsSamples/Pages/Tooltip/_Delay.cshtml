<div class="py-10">
    <!-- code begin -->
    <sa-group>
        <sa-button variant="ButtonVariant.Outline"
                    class="[interest-delay-start:1s] [--interest-delay-start:1s]"
                    interestfor="--tooltip-delay-open">
            Open Delay (1000ms)
        </sa-button>
        <sa-button variant="ButtonVariant.Outline"
                    class="[interest-delay-end:1s] [--interest-delay-end:1s]"
                    interestfor="--tooltip-delay-close">
            Close Delay (1000ms)
        </sa-button>
        <sa-tooltip id="--tooltip-delay-open">
            Opened after 1 second
        </sa-tooltip>
        <sa-tooltip id="--tooltip-delay-close">
            Will close after 1 second
        </sa-tooltip>
    </sa-group>
    <!-- code end -->
</div>
@model FieldsetImplicitModel

<div class="w-full max-w-md space-y-6">
    <!-- code begin -->
    <sa-field-set>
        <sa-field-legend>Billing address</sa-field-legend>
        <sa-field-description>
            We need your billing address to issue the invoice for your booking.
        </sa-field-description>
        <sa-field-group>
            <sa-input asp-for="Street"/>
            <div class="grid grid-cols-2 gap-4">
                <sa-input asp-for="City"/>
                <sa-input asp-for="PostalCode"/>
            </div>
        </sa-field-group>
    </sa-field-set>
    <!-- code end -->
</div>
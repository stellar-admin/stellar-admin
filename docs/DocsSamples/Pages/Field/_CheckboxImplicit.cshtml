@model CheckboxImplicitModel

<div class="w-full max-w-md">
    <!-- code begin -->
    <sa-field-group>
        <sa-field-set>
            <sa-field-legend variant="FieldLegendVariant.Label">
                Show on the destination map
            </sa-field-legend>
            <sa-field-description>
                Select the places you want to see on the destination map.
            </sa-field-description>
            <sa-field-group class="gap-3">
                <sa-input asp-for="ShowLandmarks"/>
                <sa-input asp-for="ShowRestaurants"/>
                <sa-input asp-for="ShowTransitStations"/>
                <sa-input asp-for="ShowTourGuides"/>
            </sa-field-group>
        </sa-field-set>
        <sa-field-separator/>
        <sa-input asp-for="SyncMapWithItinerary"/>
    </sa-field-group>
    <!-- code end -->
</div>

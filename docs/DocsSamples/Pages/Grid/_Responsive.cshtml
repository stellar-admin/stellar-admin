@model DocsSamples.Pages.Grid.TravellerBooking

<div class="w-full">
    <!-- code begin -->
    <sa-grid columns="2">
        <sa-field orientation="FieldOrientation.Responsive">
            <sa-field-label for="grid-responsive-first">First name</sa-field-label>
            <sa-input id="grid-responsive-first" name="FirstName" value="@Model.FirstName" />
        </sa-field>
        <sa-field orientation="FieldOrientation.Responsive">
            <sa-field-label for="grid-responsive-last">Last name</sa-field-label>
            <sa-input id="grid-responsive-last" name="LastName" value="@Model.LastName" />
        </sa-field>
        <sa-field orientation="FieldOrientation.Responsive" column-span="full">
            <sa-field-label for="grid-responsive-email">Email</sa-field-label>
            <sa-input id="grid-responsive-email" name="Email" type="email" value="@Model.Email" />
        </sa-field>
        <sa-display-field asp-for="Reference" orientation="FieldOrientation.Responsive" column-span="full" />
    </sa-grid>
    <!-- code end -->
</div>

<div class="w-full max-w-md">
    <sa-stack>
        <!-- code begin -->
        <sa-input-group>
            <sa-input-group-textarea
                placeholder="Dear Mr Okonkwo, thank you for choosing Voyager Travel..."
                class="min-h-[200px]"
            />
            <sa-input-group-addon align="InputGroupAddOnVariantAlignment.BlockEnd" class="border-t">
                <sa-input-group-text>Draft saved</sa-input-group-text>
                <sa-input-group-button size="InputGroupButtonSize.Small" class="ml-auto" variant="ButtonVariant.Default">
                    Send <sa-icon name="corner-down-left"/>
                </sa-input-group-button>
            </sa-input-group-addon>
            <sa-input-group-addon align="InputGroupAddOnVariantAlignment.BlockStart" class="border-b">
                <sa-input-group-text class="font-mono font-medium">
                    <sa-icon name="file-text" />
                    welcome-email.txt
                </sa-input-group-text>
                <sa-input-group-button class="ml-auto" size="InputGroupButtonSize.IconExtraSmall" aria-label="Regenerate">
                    <sa-icon name="refresh-ccw" />
                </sa-input-group-button>
                <sa-input-group-button variant="ButtonVariant.Ghost" size="InputGroupButtonSize.IconExtraSmall" aria-label="Copy">
                    <sa-icon name="copy" />
                </sa-input-group-button>
            </sa-input-group-addon>
        </sa-input-group>
        <!-- code end -->
    </sa-stack>
</div>
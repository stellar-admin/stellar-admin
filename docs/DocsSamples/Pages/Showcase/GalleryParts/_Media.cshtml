<div class="flex min-w-0 flex-col gap-3">
    <sa-carousel aria-label="Destination photographs">
        <sa-carousel-content>
            <sa-carousel-item aria-label="Kyoto">
                <img src="/cities/kyoto.jpg" alt="Autumn colours in Kyoto" class="h-32 w-full rounded-lg object-cover"/>
            </sa-carousel-item>
            <sa-carousel-item aria-label="Lisbon">
                <img src="/cities/lisbon.jpg" alt="Lisbon rooftops" class="h-32 w-full rounded-lg object-cover"/>
            </sa-carousel-item>
            <sa-carousel-item aria-label="Cape Town">
                <img src="/cities/cape-town.jpg" alt="Cape Town coastline" class="h-32 w-full rounded-lg object-cover"/>
            </sa-carousel-item>
        </sa-carousel-content>
        <sa-carousel-indicators/>
    </sa-carousel>
    <div class="flex items-center justify-between gap-3">
        <span class="text-sm font-medium">A change of scenery</span>
        <sa-badge variant="BadgeVariant.Outline">3 places</sa-badge>
    </div>
</div>

<div class="flex min-w-0 flex-col gap-3">
    <sa-message>
        <sa-message-avatar>
            <sa-avatar src="/avatars/avatar-1.jpg" name="Priya Raman"/>
        </sa-message-avatar>
        <sa-message-content>
            <sa-bubble variant="BubbleVariant.Secondary">
                <sa-bubble-content>Look at all these possibilities.</sa-bubble-content>
            </sa-bubble>
        </sa-message-content>
    </sa-message>
    <sa-message align="MessageAlign.End">
        <sa-message-content>
            <sa-bubble>
                <sa-bubble-content>Let's make something great. ✨</sa-bubble-content>
            </sa-bubble>
        </sa-message-content>
    </sa-message>
    <sa-input-group>
        <sa-input-group-textarea class="min-h-14" rows="1" placeholder="Write a message…" aria-label="Message"/>
        <sa-input-group-addon align="InputGroupAddOnVariantAlignment.BlockEnd">
            <sa-input-group-text>Plain text or a little personality.</sa-input-group-text>
        </sa-input-group-addon>
    </sa-input-group>
</div>

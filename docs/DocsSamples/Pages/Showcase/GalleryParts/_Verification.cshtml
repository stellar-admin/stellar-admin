<div class="flex min-w-0 flex-col gap-3">
    <sa-field>
        <sa-field-label for="gallery-otp">One-time code</sa-field-label>
        <sa-input-otp id="gallery-otp" class="max-w-fit" max-length="4" aria-label="One-time code"/>
        <sa-field-description>Four little digits. One secure sign-in.</sa-field-description>
    </sa-field>
    <sa-field>
        <sa-field-label for="gallery-notes">A few words</sa-field-label>
        <sa-textarea id="gallery-notes" class="min-h-14" rows="2" placeholder="Every good idea starts somewhere…"/>
    </sa-field>
</div>

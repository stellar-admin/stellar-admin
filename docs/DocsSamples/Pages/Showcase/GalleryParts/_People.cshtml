<div class="flex min-w-0 flex-col gap-3">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <sa-avatar-group>
            <sa-avatar src="/avatars/avatar-1.jpg" name="Priya Raman"/>
            <sa-avatar src="/avatars/avatar-2.jpg" name="Mika Tanaka"/>
            <sa-avatar src="/avatars/avatar-3.jpg" name="Alex Morgan"/>
        </sa-avatar-group>
        <sa-avatar name="Jamie Lee"/>
    </div>
    <div class="flex flex-wrap gap-2">
        <sa-badge>Published</sa-badge>

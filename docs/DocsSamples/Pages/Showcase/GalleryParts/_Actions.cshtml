<div class="flex min-w-0 flex-col gap-3">
    <div class="flex flex-wrap items-center gap-2">
        <sa-button>
            <sa-icon name="plus"/> Create</sa-button>
        <sa-button variant="ButtonVariant.Secondary">Secondary</sa-button>
        <sa-button variant="ButtonVariant.Outline">Outline</sa-button>
        <sa-button variant="ButtonVariant.Ghost">Ghost</sa-button>
        <sa-button variant="ButtonVariant.Destructive">Delete</sa-button>
        <sa-button disabled>Disabled</sa-button>
    </div>
    <sa-separator/>
    <div class="flex flex-wrap items-center gap-3">
        <sa-button-group>
            <sa-button variant="ButtonVariant.Outline" size="ButtonSize.Small">Day</sa-button>
            <sa-button variant="ButtonVariant.Outline" size="ButtonSize.Small">Week</sa-button>
            <sa-button variant="ButtonVariant.Outline" size="ButtonSize.Small">Month</sa-button>
        </sa-button-group>
        <sa-button size="ButtonSize.IconSmall" variant="ButtonVariant.Outline" aria-label="Bookmark" interestfor="gallery-tooltip">
            <sa-icon name="bookmark"/>
        </sa-button>
        <sa-tooltip id="gallery-tooltip">Keep something worth coming back to.</sa-tooltip>
        <sa-button size="ButtonSize.Small" variant="ButtonVariant.Secondary">
            <sa-spinner/> Loading</sa-button>
    </div>
</div>

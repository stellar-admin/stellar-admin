@{
    Layout = "_Layout";
}

<sa-sidebar-wrapper>
    <sa-sidebar variant="SidebarVariant.Inset">
        <sa-sidebar-header>
            <sa-button variant="ButtonVariant.Outline" commandfor="docs-sample-command" command="show-modal"
                       class="w-full justify-between text-muted-foreground">
                <span class="flex items-center gap-2">
                    <sa-icon name="search" aria-hidden="true"/>
                    Search demos...
                </span>
                <sa-kbd-group id="docs-sample-command-shortcut" aria-hidden="true">
                    <sa-kbd>Ctrl</sa-kbd>
                    <sa-kbd>K</sa-kbd>
                </sa-kbd-group>
            </sa-button>
        </sa-sidebar-header>
        <sa-sidebar-content>
            @foreach (var demoGroup in DemoNavigation.Groups)
            {
                <sa-sidebar-group>
                    <sa-sidebar-group-label>@demoGroup.Title</sa-sidebar-group-label>
                    <sa-sidebar-group-content>
                        <sa-sidebar-menu>
                            @foreach (var demoItem in demoGroup.Items)
                            {
                                <sa-sidebar-menu-item>
                                    <sa-sidebar-menu-link asp-page="@demoItem.Page">
                                        @demoItem.Title
                                    </sa-sidebar-menu-link>
                                </sa-sidebar-menu-item>
                            }
                        </sa-sidebar-menu>
                    </sa-sidebar-group-content>
                </sa-sidebar-group>
            }
        </sa-sidebar-content>
        <sa-sidebar-footer class="border-t border-sidebar-border">
            <sa-dropdown-menu>
                <sa-dropdown-menu-trigger id="docs-sample-theme-trigger" variant="ButtonVariant.Outline"
                                          class="w-full justify-between">
                    <span id="docs-sample-theme-label">Default</span>
                    <sa-icon name="chevrons-up-down" aria-hidden="true"/>
                </sa-dropdown-menu-trigger>
                <sa-dropdown-menu-content class="w-56">
                    <sa-dropdown-menu-radio-group id="docs-sample-theme-options" value="default" aria-label="Theme">
                        @foreach (var theme in new[] { "default", "ledger", "ops", "soft" })
                        {
                            <sa-dropdown-menu-radio-item value="@theme"
                                                         close-on-click="true">@(char.ToUpperInvariant(theme[0]) + theme[1..])</sa-dropdown-menu-radio-item>
                        }
                    </sa-dropdown-menu-radio-group>
                </sa-dropdown-menu-content>
            </sa-dropdown-menu>
            <sa-segmented-control id="docs-sample-mode" name="docs-sample-mode" value="system" render-field="false"
                                  aria-label="Appearance" class="w-full">
                <sa-segmented-control-item value="system" title="System">
                    <sa-icon name="monitor" aria-hidden="true"/>
                    <span class="sr-only">System</span>
                </sa-segmented-control-item>
                <sa-segmented-control-item value="light" title="Light">
                    <sa-icon name="sun" aria-hidden="true"/>
                    <span class="sr-only">Light</span>
                </sa-segmented-control-item>
                <sa-segmented-control-item value="dark" title="Dark">
                    <sa-icon name="moon" aria-hidden="true"/>
                    <span class="sr-only">Dark</span>
                </sa-segmented-control-item>
            </sa-segmented-control>
        </sa-sidebar-footer>
    </sa-sidebar>
    <sa-sidebar-inset>
        <div class="py-8 flex w-full justify-center">
            @RenderBody()
        </div>
    </sa-sidebar-inset>
</sa-sidebar-wrapper>

@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
}
<sa-command-dialog id="docs-sample-command" title="Search demos" description="Search for a demo page to open.">
    <sa-command>
        <sa-command-input placeholder="Search demos..."/>
        <sa-command-list>
            <sa-command-empty>No demos found.</sa-command-empty>
            @foreach (var demoGroup in DemoNavigation.Groups)
            {
                <sa-command-group heading="@demoGroup.Title">
                    @foreach (var demoItem in demoGroup.Items)
                    {
                        <sa-command-link-item asp-page="@demoItem.Page" keywords="@demoGroup.Title"
                                              checked="@(demoItem.Page == currentPage)">
                            @demoItem.Title
                        </sa-command-link-item>
                    }
                </sa-command-group>
            }
        </sa-command-list>
    </sa-command>
</sa-command-dialog>

@section Scripts {
    @await RenderSectionAsync("Scripts", false)
    <script src="/js/command-palette.js" asp-append-version="true"></script>
}

@section Styles {
    @await RenderSectionAsync("Styles", false)
}

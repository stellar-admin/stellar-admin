@{
    var theme = Context.Request.Query["theme"].ToString();
    string[] themes = ["aurora", "concourse", "ice", "ledger", "shadcn.luma", "shadcn.lyra", "shadcn.maia", "meridian", "shadcn.mira", "shadcn.nova", "observatory", "parallax", "shadcn.rhea", "shadcn.sera", "shadcn.vega"];
    if (!themes.Contains(theme)) { theme = "observatory"; }
    var dark = Context.Request.Query["mode"] == "dark";
}
<!DOCTYPE html>
<html lang="en" class="@(dark ? "dark" : null)">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <script src="/js/theme-fonts.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true"/>
    <link id="docs-sample-theme" data-themes="@string.Join(",", themes)" rel="stylesheet" href="@($"/_content/StellarAdmin.TagHelpers/stellar-admin.{theme}.css")" asp-append-version="true"/>
    <script src="/js/appearance.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Styles", false)
    <script defer src="/_content/StellarAdmin.TagHelpers/stellar-admin.js" asp-append-version="true"></script>
</head>
<body>
@RenderBody()
@await RenderSectionAsync("Scripts", false)
</body>
</html>
@{
    var theme = Context.Request.Query["theme"].ToString();
    string[] themes = ["concourse", "ice", "ledger", "luma", "lyra", "maia", "mira", "nova", "observatory", "rhea", "sera", "vega"];
    if (!themes.Contains(theme)) { theme = "ledger"; }
    var dark = Context.Request.Query["mode"] == "dark";
}
<!DOCTYPE html>
<html lang="en" class="@(dark ? "dark" : null)">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&amp;family=JetBrains+Mono:wght@400;500;700&amp;display=swap"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@300..700&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap"/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap"/>
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true"/>
    <link id="docs-sample-theme" data-themes="@string.Join(",", themes)" rel="stylesheet" href="@($"/_content/StellarAdmin.TagHelpers/stellar-admin.{theme}.css")" asp-append-version="true"/>
    <script src="/js/appearance.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Styles", false)
    <script defer src="/_content/StellarAdmin.TagHelpers/stellar-admin.js" asp-append-version="true"></script>
</head>
<body>
@RenderBody()
@await RenderSectionAsync("Scripts", false)
</body>
</html>
                        <sa-message-avatar>
                            <sa-avatar src="/avatars/avatar-2.jpg" name="Mika Tanaka"/>
                        </sa-message-avatar>
                        <sa-message-content>
                            <sa-bubble variant="BubbleVariant.Secondary">
                                <sa-bubble-content>
                                    Added to both. The airline confirms special meals 48 hours before departure.

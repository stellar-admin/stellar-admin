<!-- The Web SDK writes the static assets manifest the capture scenarios' hosts map -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DocsSamples\DocsSamples.csproj" />
    <ProjectReference Include="..\..\tests\StellarAdmin.ScenarioTesting\StellarAdmin.ScenarioTesting.csproj" />
  </ItemGroup>
</Project>

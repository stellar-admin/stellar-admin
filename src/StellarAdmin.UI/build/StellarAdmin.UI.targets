<Project>

  <!--
    Copies StellarAdmin.UI's Tailwind sources into obj/, for apps that run their own Tailwind build:

        @import "tailwindcss";
        @import "../../obj/stellaradmin-ui/tailwind/index.css";

    Opt in with <StellarAdminUIExportTailwindSources>true</StellarAdminUIExportTailwindSources>.
    That only puts the files on disk; the app still adds the @import and drops the
    stellar-admin-ui.css <link>.
  -->

  <PropertyGroup>
    <StellarAdminUIExportTailwindSources Condition=" '$(StellarAdminUIExportTailwindSources)' == '' ">false</StellarAdminUIExportTailwindSources>
    <!-- BaseIntermediateOutputPath, so the @import path doesn't vary by configuration or TFM. -->
    <StellarAdminUITailwindDir Condition=" '$(StellarAdminUITailwindDir)' == '' ">$(BaseIntermediateOutputPath)stellaradmin-ui/tailwind/</StellarAdminUITailwindDir>
  </PropertyGroup>

  <ItemGroup Condition=" '$(StellarAdminUIExportTailwindSources)' == 'true' ">
    <StellarAdminUITailwindFile Include="$(MSBuildThisFileDirectory)../tailwind/**/*" />
  </ItemGroup>

  <Target
    Name="StellarAdminUICopyTailwind"
    Condition=" '$(StellarAdminUIExportTailwindSources)' == 'true' "
    BeforeTargets="PrepareForBuild"
    Inputs="@(StellarAdminUITailwindFile)"
    Outputs="@(StellarAdminUITailwindFile->'$(StellarAdminUITailwindDir)%(RecursiveDir)%(Filename)%(Extension)')"
  >
    <Copy
      SourceFiles="@(StellarAdminUITailwindFile)"
      DestinationFiles="@(StellarAdminUITailwindFile->'$(StellarAdminUITailwindDir)%(RecursiveDir)%(Filename)%(Extension)')"
    />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Description>A collection of beautifully designed components you can use to create CRUD screens in ASP.NET Core MVC and Razor Pages applications</Description>
    <!-- Ship XML documentation so consumers get IntelliSense on the tag helpers.
         The SDK packs the generated .xml alongside the assembly automatically. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <NoWarn>1701;1702</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA2264</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\..\gen\StellarAdmin.Generators\StellarAdmin.Generators.csproj"
      ReferenceOutputAssembly="false"
      OutputItemType="Analyzer"
    />
    <AdditionalFiles Include="Icons/Definitions/Lucide.json" />
    <AdditionalFiles Include="Icons/Definitions/TablerFilled.json" />
    <AdditionalFiles Include="Icons/Definitions/TablerOutline.json" />
    <AdditionalFiles Include="Icons/Definitions/Keywords/*.json" />
    <!-- The generator compiles the icons into the assembly; the JSON isn't content -->
    <Content Remove="Icons/Definitions/**" />
    <!-- The generator's attributes, such as [GenerateDataAttributeText] -->
    <Using Include="StellarAdmin.Generators" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/ComputedValue.cs" Link="Shared/ComputedValue.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <!-- Configure namespace provider for TagHelpers -->
  <ItemGroup>
    <Folder Include="TagHelpers\**\" NamespaceProvider="False" />
    <Folder Remove="TagHelpers\" />
  </ItemGroup>

  <!-- Client -->
  <Import Project="../../build/Client.targets" />

  <ItemGroup>
    <ClientInput Include="Client/css/**/*.css" />
    <ClientInput Include="Client/css/theme-variables.json" />
    <ClientInput Include="Client/js/**/*.js" />
    <ClientInput Include="Client/scripts/*.mjs" />
    <ClientInput Include="Client/rolldown.config.js" />
    <ClientInput Include="Client/package.json" />
  </ItemGroup>

  <!-- Declared at execution time, as Client.targets explains: Rider stripped these in the
       StellarAdmin.UI rename, and the Client target was silently skipped on every build. -->
  <Target Name="ClientItems">
    <ItemGroup>
      <ClientOutput Include="wwwroot/stellar-admin.js" />
      <ClientOutput Include="wwwroot/rich-text-editor.js" />
      <ClientOutput Include="wwwroot/stellar-admin.css" />
      <ClientOutput Include="wwwroot/stellar-admin.tailwind.css" />
      <ClientOutput Include="wwwroot/stellar-admin.theme-variables.json" />
    </ItemGroup>
  </Target>
</Project>

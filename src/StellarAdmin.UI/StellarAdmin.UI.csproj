<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RootNamespace>StellarAdmin.UI</RootNamespace>
    <Description>A collection of beautifully designed components you can use to create CRUD screens in ASP.NET Core MVC and Razor Pages applications</Description>
    <!-- Ship XML documentation so consumers get IntelliSense on the tag helpers.
         The SDK packs the generated .xml alongside the assembly automatically. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <NoWarn>1701;1702</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA2264</NoWarn>
    <!-- CS1591 (missing XML comment) also fires on DI constructors and ProcessAsync
         overrides, which never appear in Razor IntelliSense. The consumer-facing surface
         (tag-helper classes, [HtmlAttributeName] properties, enums) is documented; the rest
         is intentionally suppressed rather than filled with boilerplate. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TailwindMerge.NET" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\..\gen\StellarAdmin.UI.Generators\StellarAdmin.UI.Generators.csproj"
      ReferenceOutputAssembly="false"
      OutputItemType="Analyzer"
    />
    <ProjectReference Include="..\StellarAdmin.Core\StellarAdmin.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>
  <!-- Client -->
  <ItemGroup>
    <Content Update="Client/**/*.*" Pack="false" />
  </ItemGroup>
  <!--
    Tailwind sources for single-build mode. These are packed as plain files, NOT as static web
    assets — a consuming app's Tailwind build reads them off disk; they must never be served
    under _content/.
  -->
  <ItemGroup>
    <Content Update="tailwind/**/*.*" Pack="false" />
    <!-- The Razor SDK emits build/*.props and buildTransitive/*.props but never a .targets, so
         shipping to both is required: without buildTransitive, a project that references this
         package through an intermediate class library gets no tailwind/ folder at all. -->
    <None
      Include="build\StellarAdmin.UI.targets"
      Pack="true"
      PackagePath="build\StellarAdmin.UI.targets;buildTransitive\StellarAdmin.UI.targets"
    />
  </ItemGroup>
  <!--
    tailwind/** is collected during pack rather than by a project-scope <None> glob, because
    tailwind/utility-classes.txt is generated by the ClientUtilityClasses target. A project-scope
    glob expands at evaluation time — before any target runs — so on a clean checkout it would
    silently pack without the class list. A consumer would then get a stylesheet containing none of
    the library's classes, and because Tailwind ignores a missing @source without complaint, no
    error either. TargetsForTfmSpecificContentInPackage runs after Build, so the glob sees the
    generated file.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);StellarAdminUIPackTailwindSources
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="StellarAdminUIPackTailwindSources">
    <ItemGroup>
      <StellarAdminUITailwindPackFile Include="tailwind/**/*" />
      <TfmSpecificPackageFile
        Include="@(StellarAdminUITailwindPackFile)"
        PackagePath="tailwind/%(RecursiveDir)%(Filename)%(Extension)"
      />
    </ItemGroup>
    <Error
      Condition=" !Exists('tailwind/utility-classes.txt') "
      Text="StellarAdmin.UI: tailwind/utility-classes.txt is missing, so the package would ship without the Tailwind class list and single-build consumers would silently get no library styles. Run a build first (the ClientUtilityClasses target generates it)."
    />
  </Target>
  <!--
    The client build is split into three incremental targets. Inputs/Outputs matter here: without
    them these Execs run on every build, which cost ~360ms (css) and ~380ms (js) unconditionally.
  -->
  <ItemGroup>
    <ClientCssInput Include="Client/css/**/*.css;tailwind/**/*.css;Theming/ThemePacks/*.themepack" />
    <ClientJsInput Include="Client/js/**/*.ts;Client/js/**/*.js;Client/rolldown.config.js;Client/tsconfig.json" />
  </ItemGroup>
  <Target Name="ClientInstall" BeforeTargets="ClientUtilityClasses;ClientCss;ClientJs">
    <Exec
      WorkingDirectory="Client"
      Command="npm install"
      Condition=" !Exists('Client/node_modules') "
    />
  </Target>
  <!--
    Dumps the Tailwind candidates used by the tag helpers and theme packs, for consuming apps that
    run their own Tailwind build (single-build mode). Depends on the .cs sources, so it is keyed on
    @(Compile) rather than on a directory.
  -->
  <!--
    Stamp files, not the real outputs, drive the up-to-date checks. Tailwind (and rolldown) skip
    the write when the emitted content is unchanged, leaving the output's timestamp behind the
    inputs' — so keying on the output directly makes the target re-run on every build after any
    .cs edit that doesn't happen to alter the class set, which is most of them.
  -->
  <Target
    Name="ClientUtilityClasses"
    BeforeTargets="ClientCss"
    Inputs="@(Compile);@(ClientCssInput)"
    Outputs="$(IntermediateOutputPath)client-utility-classes.stamp"
  >
    <Exec Command="npm run build:utility-classes" WorkingDirectory="Client" />
    <Touch Files="$(IntermediateOutputPath)client-utility-classes.stamp" AlwaysCreate="true" />
  </Target>
  <Target
    Name="ClientCss"
    BeforeTargets="Build"
    Inputs="@(Compile);@(ClientCssInput)"
    Outputs="$(IntermediateOutputPath)client-css.stamp"
  >
    <Exec Command="npm run build:css" WorkingDirectory="Client" />
    <Touch Files="$(IntermediateOutputPath)client-css.stamp" AlwaysCreate="true" />
  </Target>
  <Target
    Name="ClientJs"
    BeforeTargets="Build"
    Inputs="@(ClientJsInput)"
    Outputs="$(IntermediateOutputPath)client-js.stamp"
  >
    <Exec Command="npm run build:js" WorkingDirectory="Client" />
    <Touch Files="$(IntermediateOutputPath)client-js.stamp" AlwaysCreate="true" />
  </Target>
  <!-- Icon packs -->
  <ItemGroup>
    <Content Update="Icons/Definitions/**/*.*" Pack="false" />
    <!--<AdditionalFiles Include="Icons\Definitions\*.json" />-->
    <AdditionalFiles Include="Icons\Definitions\Lucide.json" />
  </ItemGroup>
  <!-- Theme packs -->
  <ItemGroup>
    <Content Update="Theming/ThemePacks/**/*.*" Pack="false" />
    <AdditionalFiles Include="Theming\ThemePacks\*.themepack" />
  </ItemGroup>
  <!-- Configure namespace provider for TagHelpers -->
  <ItemGroup>
    <Folder Include="TagHelpers\**\" NamespaceProvider="False" />
    <Folder Remove="TagHelpers\" />
  </ItemGroup>
</Project>

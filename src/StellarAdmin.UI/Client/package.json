{
  "name": "stellar-admin-ui",
  "type": "module",
  "scripts": {
    "build": "npm run build:vendor && npm run build:css",
    "build:css": "node ./scripts/build-css.mjs",
    "build:vendor": "node ./scripts/copy-vendor.mjs",
    "check": "tsc -p .",
    "fmt": "cd .. && oxfmt wwwroot/js wwwroot/stellar-admin.js",
    "fmt:check": "cd .. && oxfmt --check wwwroot/js wwwroot/stellar-admin.js"
  },
  "dependencies": {
    "interestfor": "^1.0.8"
  },
  "devDependencies": {
    "oxfmt": "^0.36.0",
    "typescript": "^5.9.3"
  }
}

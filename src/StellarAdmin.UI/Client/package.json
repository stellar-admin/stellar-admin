{
  "name": "stellar-admin-ui",
  "type": "module",
  "scripts": {
    "build": "npm run build:utility-classes && npm run build:js && npm run build:css",
    "build:css": "node ./scripts/build-theme-bundles.mjs",
    "build:utility-classes": "node ./scripts/gen-utility-classes.mjs .. ../tailwind/utility-classes.txt",
    "build:js": "rolldown -c",
    "build:js:watch": "rolldown -c rolldown.config.js -w",
    "sync:vendor": "node ./scripts/sync-vendor.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "interestfor": "^1.0.8",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "oxfmt": "^0.36.0",
    "rolldown": "^1.0.0-rc.3",
    "rollup-plugin-minify-html-literals": "^1.2.6",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateRazorAssemblyInfo>false</GenerateRazorAssemblyInfo>
    <Description>StellarAdmin admin panel resource screens for Entity Framework Core</Description>
    <PackageTags>admin;admin-panel;crud;entity-framework-core</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <ProjectReference Include="../StellarAdmin/StellarAdmin.csproj" />
  </ItemGroup>
</Project>

@model ResourceIndexDeleteDialogViewModel

@* The index page's delete confirmation. The grid's delete buttons reference
   confirmResourceDelete via hx-confirm; the promise resolves with the user's choice. *@
<sa-alert-dialog id="--delete-confirmation-dialog">
    <sa-alert-dialog-header>
        <sa-alert-dialog-title>@Model.Title</sa-alert-dialog-title>
        <sa-alert-dialog-description></sa-alert-dialog-description>
    </sa-alert-dialog-header>
    <form method="dialog">
        <sa-alert-dialog-footer>
            <sa-alert-dialog-cancel>@Model.CancelLabel</sa-alert-dialog-cancel>
            <sa-alert-dialog-action
                variant="ButtonVariant.Destructive">@Model.ConfirmLabel</sa-alert-dialog-action>
        </sa-alert-dialog-footer>
    </form>
</sa-alert-dialog>

<script>
    async function confirmResourceDelete(elt) {
        const alertDialogElement = document.getElementById("--delete-confirmation-dialog");

        const description = alertDialogElement.querySelector("[data-slot='alert-dialog-description']");
        if (description) description.textContent = elt.dataset.deleteMessage ?? "Are you sure you want to delete this record?";

        const alertDialog = window.stellarAdmin.alertDialog(alertDialogElement);

        return await alertDialog.confirmAsync();
    }
</script>

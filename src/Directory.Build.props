<Project>
  <PropertyGroup>
    <Authors>Jerrie Pelser</Authors>
    <Copyright>Copyright © 2026 Jerrie Pelser</Copyright>
    <PackageTags>tag helper;shadcn;crud</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/stellar-admin/stellar-admin</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/stellar-admin/stellar-admin.git</RepositoryUrl>
    <!-- Must match the packed file's name exactly; the repo file is lowercase and pack is
         case-sensitive on Linux/macOS. -->
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageIcon>stellar-admin-symbol.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\assets\logo\stellar-admin-symbol.png" Pack="true" PackagePath="" />
    <None Include="..\..\readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>

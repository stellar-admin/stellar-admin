@model SetupStepViewModel

@{
    var open = ViewData["Open"] is true;
    var variant = Model.Done ? ButtonVariant.Ghost : Model.Essential ? ButtonVariant.Default : ButtonVariant.Outline;
}

<sa-checklist-item status="@(Model.Done ? ChecklistStatus.Done : null)" description="@Model.Description">
    @if (!Model.Done && Model.Warn)
    {
        <sa-checklist-item-status label="Needs attention">
            <sa-icon name="triangle-alert" class="text-[var(--sa-color-warning)]"/>
        </sa-checklist-item-status>
    }
    else if (!Model.Done && Model.Optional)
    {
        <sa-checklist-item-status label="Optional">
            <sa-icon name="circle-dashed"/>
        </sa-checklist-item-status>
    }
    <sa-checklist-item-title muted="Model.Done">
        @Model.Title
        @if (Model.Optional && !Model.Done)
        {
            <sa-badge variant="BadgeVariant.Outline">Optional</sa-badge>
        }
    </sa-checklist-item-title>
    <sa-checklist-item-actions>
        <sa-button variant="variant" size="ButtonSize.Small" commandfor="--setup-step-@Model.Id" command="--toggle" class="sa-setup-toggle">
            @(Model.Done ? "Change" : "Show me how")
            <sa-icon name="chevron-down"/>
        </sa-button>
    </sa-checklist-item-actions>
    <sa-collapsible id="--setup-step-@Model.Id" hidden="@(open ? null : "")" class="grid grid-cols-[minmax(0,1fr)] gap-3">
        @if (Model.Detail is { } detail)
        {
            <p class="text-sm text-muted-foreground">@detail</p>
        }
        <partial name="_SetupTabs" model="@(new SetupTabsViewModel(Model.Id, Model.Install, Model.Code, Model.AgentPrompt))" />
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <partial name="_SetupLink" model="Model.Docs" />
            @if (Model.ExtraLink is { } extra)
            {
                <partial name="_SetupLink" model="extra" />
            }
        </div>
    </sa-collapsible>
</sa-checklist-item>

@using StellarAdmin.Resources
@model IResourceIndexPageViewModel
@{
    // The widgets' regions, which a search replaces along with the grid. Only the index's own request renders them.
    var widgets = ViewData[ViewDataKeys.Widgets] as PageWidgetsViewModel;
    var widgetRegions = widgets is null
        ? []
        : new[] { (widgets.Top, "#index-page-widgets-top"), (widgets.Aside, "#index-page-widgets-aside"), (widgets.Bottom, "#index-page-widgets-bottom") }
            .Where(region => region.Item1 is not null)
            .Select(region => region.Item2)
            .ToArray();
    var searchOob = string.Join(", ", (Model.Scopes.Count > 0 ? new[] { "#index-page-scopes" } : []).Concat(widgetRegions));
}

@* The list as one card: the scopes and the search above the grid. The search stays outside the grid its typing replaces.
   The layout switcher sits on its own row above the card, right-aligned; the two stay together as one item, so an
   aside column of widgets sits beside both *@
@if (Model.Layouts.Count > 0)
{
    <div class="sa-resource-index-list-stack">
        <div class="sa-resource-index-layouts-row">
            @* Switching data layout loads the whole page, since the data layout decides which controls show. It keeps the scope
               and the search; sort and paging belong to the table they were chosen in. Without a settle, htmx would
               carry the old radios' attributes over to the new ones that share their ids, and lose the selection *@
            <sa-segmented-control name="layout" value="@Model.Layouts.First(layout => layout.IsActive).Key"
                                  aria-label="Layout" class="sa-resource-index-layouts"
                                  hx-get="@Url.Action("Index", new { id = (string?)null, scope = Model.Query.Scope, search = Model.Query.Search })"
                                  hx-trigger="change" hx-include="find input:checked"
                                  hx-target="body" hx-swap="innerHTML settle:0" hx-push-url="true">
                @foreach (var layout in Model.Layouts)
                {
                    <sa-segmented-control-item value="@layout.Key" title="@layout.Title">
                        @if (layout.Icon is { } icon)
                        {
                            <sa-icon name="@icon" />
                            <span class="sr-only">@layout.Title</span>
                        }
                        else
                        {
                            @layout.Title
                        }
                    </sa-segmented-control-item>
                }
            </sa-segmented-control>
        </div>
        @{ await ListCard(); }
    </div>
}
else
{
    await ListCard();
}

@{
    async Task ListCard()
    {
        <sa-card class="sa-resource-index-list">
            @if (Model.Search is not null || Model.Scopes.Count > 0)
            {
                <div class="sa-resource-index-controls">
                    @if (Model.Scopes.Count > 0)
                    {
                        <sa-tab-list id="index-page-scopes" variant="TabListVariant.Line" aria-label="Scopes" hx-boost:inherited="true">
                            @foreach (var scope in Model.Scopes)
                            {
                                <sa-tab-link active="scope.IsActive" asp-action="Index" asp-route-id="@((string?)null)"
                                             asp-route-layout="@Model.Query.Layout"
                                             asp-route-scope="@scope.QueryValue" asp-route-search="@Model.Query.Search"
                                             asp-route-sortBy="@Model.Query.SortBy" asp-route-sortDirection="@Model.Query.SortDirection"
                                             asp-route-pageSize="@Model.Query.PageSize">
                                    @scope.Title
                                </sa-tab-link>
                            }
                        </sa-tab-list>
                    }
                    @if (Model.Search is { } search)
                    {
                        <sa-input-group id="index-page-search" class="sa-resource-index-search">
                            <sa-input-group-input id="index-page-search-input"
                                                  placeholder="@search.Placeholder"
                                                  aria-label="@search.Placeholder"
                                                  autofocus=""
                                                  value="@search.Term"
                                                  name="search"
                                                  hx-get="@Url.Action("Index", new
                                                          {
                                                              id = (string?)null,
                                                              layout = Model.Query.Layout,
                                                              scope = Model.Query.Scope,
                                                              sortBy = Model.Query.SortBy,
                                                              sortDirection = Model.Query.SortDirection,
                                                              pageSize = Model.Query.PageSize
                                                          })"
                                                  hx-trigger="input changed delay:400ms"
                                                  hx-swap="outerHTML"
                                                  hx-target="#index-page-data-grid"
                                                  hx-select="#index-page-data-grid"
                                                  hx-select-oob="@(searchOob.Length > 0 ? searchOob : null)"
                                                  hx-push-url="true" />
                            <sa-input-group-addon>
                                <sa-icon name="search" />
                            </sa-input-group-addon>
                        </sa-input-group>
                    }
                </div>
            }
            <partial name="_IndexPageGrid" />
        </sa-card>
    }
}

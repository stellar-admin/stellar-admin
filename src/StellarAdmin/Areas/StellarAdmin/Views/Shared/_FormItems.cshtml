@inherits FormFieldsBaseView<object>
@{
    var editorData = ViewData[ViewDataKeys.EditorData] as IReadOnlyDictionary<string, object?>;
    var editorTemplates = ViewData[ViewDataKeys.EditorTemplates] as IReadOnlyDictionary<string, string>;
    var columns = (ViewData[ViewDataKeys.FormColumns] as FormGridColumnDefinitions? ?? default).Resolve();
    var orientation = ViewData[ViewDataKeys.FormOrientation] as FieldOrientation?;
    // A view section's orientation also applies to the display fields in it
    var displayOrientation = orientation switch
    {
        FieldOrientation.Horizontal => DisplayFieldOrientation.Horizontal,
        FieldOrientation.Vertical => DisplayFieldOrientation.Vertical,
        _ => (DisplayFieldOrientation?)null,
    };
}
<sa-grid columns-base="@columns.Base" columns-sm="@columns.Small" columns-md="@columns.Medium" columns-lg="@columns.Large">
    @foreach (var item in Items)
    {
        // Every item sits in a grid item that carries its placement, since editor templates render arbitrary markup
        var span = item.ColumnSpan.Resolve(columns);
        var start = item.ColumnStart.Resolve(columns, span);
        var placementStyles = new[] { ResponsiveGrid.SpanStyle(span), ResponsiveGrid.StartStyle(start) }.OfType<string>().ToArray();
        var placementStyle = placementStyles.Length > 0 ? string.Join(';', placementStyles) : null;

        <sa-grid-item style="@placementStyle">
            @if (item is FormFieldOptions field)
            {
                @Html.Editor(field.FieldName, editorTemplates?.GetValueOrDefault(field.FieldName), new Dictionary<string, object>
                {
                    [ViewDataKeys.FormFieldProperties] = new FormFieldProperties
                    {
                        Description = field.Description,
                        EditorData = editorData?.GetValueOrDefault(field.FieldName),
                        Editor = field.Editor,
                        FieldName = field.FieldName,
                        IsReadOnly = field.IsReadOnly,
                        Title = field.Title,
                    },
                })
            }
            else if (item is FormDisplayFieldOptions displayField)
            {
                using (var scope = BeginField(displayField))
                {
                    <sa-display-field asp-for="@Model" label="@displayField.Title" empty-text="@displayField.EmptyText" template="@scope.TemplateName" template-renders-empty="@scope.TemplateRendersEmpty"
                                      orientation="@(displayField.Orientation ?? displayOrientation)" />
                }
            }
            else if (item is FormDetailsOptions details)
            {
                var detailsViewData = new ViewDataDictionary(ViewData) { [ViewDataKeys.FormContainer] = details };

                <partial name="_FormDetails" model="@Model" view-data="@detailsViewData" />
            }
            else if (item is FormContainerOptions container)
            {
                var partial = container switch
                {
                    FormSectionOptions => "_FormSection",
                    FormGroupOptions => "_FormGroup",
                    _ => throw new InvalidOperationException("Unknown form container."),
                };
                var containerViewData = new ViewDataDictionary(ViewData)
                {
                    [ViewDataKeys.FormContainer] = container,
                    [ViewDataKeys.FormItems] = container.Items,
                    [ViewDataKeys.FormColumns] = container.Columns,
                    [ViewDataKeys.FormOrientation] = (container as FormSectionOptions)?.Orientation ?? orientation,
                };

                <partial name="@partial" model="@Model" view-data="@containerViewData" />
            }
        </sa-grid-item>
    }
</sa-grid>

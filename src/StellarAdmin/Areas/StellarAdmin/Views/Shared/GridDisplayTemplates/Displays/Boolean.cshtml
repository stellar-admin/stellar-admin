@using Microsoft.Extensions.Options
@using StellarAdmin.Resources.Displays
@using StellarAdmin.UI.Icons
@inherits FieldDisplayView<BooleanDisplay>
@inject IOptions<IconOptions> IconOptions

@{
    var value = Model is true;
    var text = value ? Display.TrueText : Display.FalseText;
    var icon = IconOptions.Value.GetSemanticIconName(value ? SemanticIconRole.BooleanTrue : SemanticIconRole.BooleanFalse);
}

<span class="sa-boolean-display" data-value="@(value ? "true" : "false")">
    @if (Display.Appearance != BooleanDisplayAppearance.Text)
    {
        <sa-icon name="@icon" class="size-4" aria-hidden="true" />
    }
    <span class="@(Display.Appearance == BooleanDisplayAppearance.Icon ? "sr-only" : null)">@text</span>
</span>

@using StellarAdmin.Diagnostics
@model IReadOnlyList<ConfigurationProblem>

@* Development's page for a resource whose configuration turned it off; other environments return a plain 404 *@
@{
    Layout = StellarAdminLayouts.Default;
    ViewData["Title"] = "Resource turned off";
}

<div class="p-6">
    <sa-empty>
        <sa-empty-header>
            <sa-empty-media variant="EmptyMediaVariant.Icon">
                <sa-icon name="circle-alert" />
            </sa-empty-media>
            <sa-empty-title>This resource is turned off</sa-empty-title>
            <sa-empty-description>
                @foreach (var problem in Model.Where(problem => problem.Effect == ConfigurationProblemEffect.ResourceOff))
                {
                    <span class="block">@problem.Message</span>
                }
            </sa-empty-description>
        </sa-empty-header>
        <sa-empty-content>
            <p class="text-muted-foreground text-sm">Only Development shows this page. Other environments return 404.</p>
        </sa-empty-content>
    </sa-empty>
</div>

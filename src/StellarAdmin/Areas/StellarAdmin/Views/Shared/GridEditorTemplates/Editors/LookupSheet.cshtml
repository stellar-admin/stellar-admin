@using Microsoft.AspNetCore.Mvc.ModelBinding
@using StellarAdmin.Resources
@inherits FieldEditorView<LookupSheetEditor>
@inject Microsoft.Extensions.Options.IOptions<ResourceLabelOptions> LabelOptions

@{
    var data = (LookupSheetEditorData?)EditorData;
    var item = data?.Item;
    var label = Title ?? ViewData.ModelMetadata.GetDisplayName();
    var canLookUp = !IsReadOnly && Field?.FieldName is not null;
    var isInvalid = ViewData.ModelState.GetFieldValidationState(Html.NameForModel()) == ModelValidationState.Invalid;
    // A cell always shows the selection on one line, whatever the form's layout
    var selection = new LookupSelectionViewModel(item, LookupSheetEditorLayout.Input, Editor.FieldOptions.ShowMedia, !canLookUp, Editor.ClassNames.Media);
    var labels = LabelOptions.Value;
    var labelContext = new LookupLabelContext(label, Editor.SheetOptions.MinimumSearchLength, null);
    // While a field its items depend on has no value, the lookup is disabled and says why, and its value is cleared
    var waiting = WaitingText is not null;
    var chooseText = WaitingText ?? Editor.FieldOptions.EmptyText ?? labels.Lookup.ChooseLabel(labelContext);

    // The selection and the empty buttons are both rendered, and the script shows one; the hidden input carries the posted value
    var id = Html.IdForModel();
    var form = ViewData[ViewDataKeys.LookupForm] as string ?? ViewContext.RouteData.Values["action"]?.ToString()?.ToLowerInvariant();
    var sheetUrl = canLookUp
        ? Url.Action("LookupSheet", new { id = form == "edit" ? ViewContext.RouteData.Values["id"] : null, form, field = Field!.FieldName, @for = id })
        : null;
}

@* A disabled lookup disables its buttons and its posted values, as the fieldset disables every control in it *@
<fieldset class="contents" role="none" disabled="@IsDisabled">
    <admin-lookup-sheet-editor class="contents">
        @if (waiting)
        {
            <input type="hidden" id="@id" name="@Html.NameForModel()" value="" data-lookup="value" />
        }
        else
        {
            <input type="hidden" asp-for="@Model" data-lookup="value" />
        }

        @if (!canLookUp)
        {
            <span class="flex min-w-0 items-center gap-2">
                <partial name="_LookupSelection" model="selection" />
            </span>
        }
        else
        {
            <div data-lookup="selected" hidden="@(item is null)">
                <sa-button type="button" id="@($"{id}-change")" variant="ButtonVariant.Outline" size="ButtonSize.Small" class="sa-cell-editor sa-lookup-trigger"
                           aria-invalid="@(isInvalid ? "true" : null)" aria-describedby="@CellErrorId" data-sheet-open="@sheetUrl" data-lookup="open">
                    <span class="sr-only">@labels.Lookup.ChangeLabel(labelContext) @label, </span>
                    <partial name="_LookupSelection" model="selection" />
                    <sa-icon name="chevrons-up-down" />
                </sa-button>
            </div>
            <div data-lookup="empty" hidden="@(item is not null)">
                <sa-button type="button" id="@($"{id}-choose")" variant="ButtonVariant.Outline" size="ButtonSize.Small" class="sa-cell-editor sa-lookup-trigger"
                           data-empty aria-invalid="@(isInvalid ? "true" : null)" aria-describedby="@CellErrorId" data-sheet-open="@sheetUrl" data-lookup="open" disabled="@(waiting ? "disabled" : null)">
                    <span class="truncate">@chooseText</span>
                    <sa-icon name="search" />
                </sa-button>
            </div>
        }
    </admin-lookup-sheet-editor>
</fieldset>

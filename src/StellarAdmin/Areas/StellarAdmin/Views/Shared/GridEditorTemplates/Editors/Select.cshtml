@inherits FieldEditorView<SelectEditor>

@{
    var items = ChoiceSelectListItems.Create(Editor.ResolveChoices(EditorData, ViewData.ModelMetadata, Model));
}

<sa-select class="sa-cell-editor" wrap-in-field="false" size="SelectSize.Small" asp-for="@Model" asp-items="@items" disabled="@IsReadOnly"
           aria-label="@(Title ?? ViewData.ModelMetadata.GetDisplayName())" aria-describedby="@CellErrorId" />

@inherits FieldEditorView<SelectEditor>

@{
    // While a field its choices depend on has no value, the select is disabled and its only choice says why. A disabled
    // select doesn't post, so the hidden input clears the value it had
    var waiting = WaitingText is not null;
    var items = ChoiceSelectListItems.Create(waiting ? [new ChoiceItem("", WaitingText!)] : Editor.ResolveChoices(EditorData, ViewData.ModelMetadata, Model));
}

@if (waiting)
{
    <input type="hidden" name="@Html.NameForModel()" value="" />
}
<sa-select class="sa-cell-editor" wrap-in-field="false" size="SelectSize.Small" asp-for="@Model" asp-items="@items" disabled="@(IsReadOnly || waiting)"
           aria-label="@(Title ?? ViewData.ModelMetadata.GetDisplayName())" aria-describedby="@CellErrorId" />

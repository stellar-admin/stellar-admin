@inherits FieldEditorView<ToggleEditor>

@{
    BooleanProperty.Ensure(Editor, ViewData.ModelMetadata);
}

<span class="sa-cell-check">
    <sa-switch wrap-in-field="false" size="SwitchSize.Small" asp-for="@Model" readonly="@IsReadOnly" disabled="@IsDisabled"
               aria-label="@(Title ?? ViewData.ModelMetadata.GetDisplayName())" aria-describedby="@CellErrorId" />
</span>

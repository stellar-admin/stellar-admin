@inherits FieldEditorView<ImageEditor>

@{
    var data = (ImageEditorData?)EditorData;

    // The row names the form it edits, so the upload checks the field against that form
    var canUpload = !IsReadOnly && Field?.FieldName is not null;
    var form = ViewData[ViewDataKeys.LookupForm] as string ?? ViewContext.RouteData.Values["action"]?.ToString()?.ToLowerInvariant();
    var uploadUrl = canUpload ? Url.Action("UploadImage", new { id = (string?)null, form, field = Field!.FieldName }) : null;
}

<sa-image-upload class-names="@EditorClassNamesMapper.ForImageUpload(Editor)" render-field="false" asp-for="@Model" src="@data?.Url" upload-url="@uploadUrl" layout="ImageUploadLayout.Cell"
                 accept="@string.Join(',', Editor.AcceptedTypes)" max-file-size="Editor.MaxFileSize" disabled="!canUpload"
                 aria-label="@(Title ?? ViewData.ModelMetadata.GetDisplayName())" aria-describedby="@CellErrorId" />

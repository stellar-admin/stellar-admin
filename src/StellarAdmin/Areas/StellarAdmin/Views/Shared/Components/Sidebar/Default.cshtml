@using StellarAdmin.Sidebar
@model List<StellarAdmin.Sidebar.SidebarItem>
@inject BrandingResolver Branding
@inject UserMenuResolver UserMenus

<sa-sidebar>
    <sa-sidebar-header>
        <partial name="/Areas/StellarAdmin/Views/Shared/_SidebarBrand.cshtml" model="Branding.CreateBrand(Url)"/>
        <sa-button variant="ButtonVariant.Outline" commandfor="--command-palette" command="show-modal"
                   class="w-full justify-between text-muted-foreground">
            <span class="flex items-center gap-2">
                <sa-icon name="search" aria-hidden="true"/>
                Search...
            </span>
            <sa-kbd-group id="--command-palette-shortcut" aria-hidden="true">
                <sa-kbd>Ctrl</sa-kbd>
                <sa-kbd>K</sa-kbd>
            </sa-kbd-group>
        </sa-button>
    </sa-sidebar-header>

    <sa-sidebar-content>
        @for (var index = 0; index < Model.Count;)
        {
            if (Model[index] is SidebarGroupItem groupItem)
            {
                await RenderSidebarGroupItem(groupItem);
                index++;
                continue;
            }

            // Top-level links render as a group without a heading, so they sit in a sidebar menu.
            var linkItems = new List<SidebarItem>();
            while (index < Model.Count && Model[index] is not SidebarGroupItem)
            {
                linkItems.Add(Model[index++]);
            }

            <sa-sidebar-group>
                <sa-sidebar-group-content>
                    <sa-sidebar-menu>
                        @foreach (var linkItem in linkItems)
                        {
                            await RenderSidebarItem(linkItem);
                        }
                    </sa-sidebar-menu>
                </sa-sidebar-group-content>
            </sa-sidebar-group>
        }
    </sa-sidebar-content>

    @if (UserMenus.CreateUserMenu(User) is { } userMenu)
    {
        <sa-sidebar-footer>
            <partial name="/Areas/StellarAdmin/Views/Shared/_SidebarUserMenu.cshtml" model="userMenu"/>
        </sa-sidebar-footer>
    }
</sa-sidebar>

<partial name="/Areas/StellarAdmin/Views/Shared/_CommandPalette.cshtml" model="Model"/>

@{
    async Task RenderSidebarItem(SidebarItem sidebarItem)
    {
        switch (sidebarItem)
        {
            case SidebarGroupItem groupItem: await RenderSidebarGroupItem(groupItem); break;
            case SidebarLinkItem linkItem: await RenderSidebarLinkItem(linkItem); break;
            case SidebarActionLinkItem actionLinkItem: await RenderSidebarActionLinkItem(actionLinkItem); break;
            case SidebarPageLinkItem pageLinkItem: await RenderSidebarPageLinkItem(pageLinkItem); break;
        }
    }

    async Task RenderSidebarGroupItem(SidebarGroupItem sidebarGroupItem)
    {
        <sa-sidebar-group>
            <sa-sidebar-group-label>@sidebarGroupItem.Label</sa-sidebar-group-label>
            <sa-sidebar-group-content>
                <sa-sidebar-menu>
                    @foreach (var subItem in sidebarGroupItem.Items)
                    {
                        await RenderSidebarItem(subItem);
                    }
                </sa-sidebar-menu>
            </sa-sidebar-group-content>
        </sa-sidebar-group>
    }

    async Task RenderSidebarLinkItem(SidebarLinkItem linkItem)
    {
        <sa-sidebar-menu-item>
            <sa-sidebar-menu-link href="@Url.Content(linkItem.Href)" target="@Target(linkItem)" rel="@Rel(linkItem)">
                <span>@linkItem.Label</span>
            </sa-sidebar-menu-link>
        </sa-sidebar-menu-item>
    }

    async Task RenderSidebarActionLinkItem(SidebarActionLinkItem actionLinkItem)
    {
        <sa-sidebar-menu-item>
            <sa-sidebar-menu-link asp-controller="@actionLinkItem.Controller" asp-action="@actionLinkItem.Action"
                                   asp-area="@actionLinkItem.Area" target="@Target(actionLinkItem)"
                                   rel="@Rel(actionLinkItem)">
                <span>@actionLinkItem.Label</span>
            </sa-sidebar-menu-link>
        </sa-sidebar-menu-item>
    }

    async Task RenderSidebarPageLinkItem(SidebarPageLinkItem pageLinkItem)
    {
        <sa-sidebar-menu-item>
            <sa-sidebar-menu-link asp-page="@pageLinkItem.Page" asp-area="@pageLinkItem.Area"
                                   target="@Target(pageLinkItem)" rel="@Rel(pageLinkItem)">
                <span>@pageLinkItem.Label</span>
            </sa-sidebar-menu-link>
        </sa-sidebar-menu-item>
    }

    string? Target(SidebarLinkItemBase linkItem) => linkItem.OpenInNewTab ? "_blank" : null;

    string? Rel(SidebarLinkItemBase linkItem) => linkItem.OpenInNewTab ? "noopener noreferrer" : null;
}
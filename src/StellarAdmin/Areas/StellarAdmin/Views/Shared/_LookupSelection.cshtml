@model LookupSelectionViewModel

@{
    var item = Model.Item;
    var isCard = Model.Layout == LookupSheetEditorLayout.Card;

    var placement = isCard ? ItemMediaPlacement.LookupLarge : ItemMediaPlacement.Lookup;
    var media = Model.ShowMedia && item is not null ? ItemMediaViewModel.Create(item.Media, item.Text, placement, Model.MediaClass) : null;
}

@* The editable layouts mark their parts with data-lookup, so selecting a result can swap in that result's parts *@
@if (isCard)
{
    <sa-item-media data-lookup="media" hidden="@(media is null)">
        @if (media is not null)
        {
            <partial name="_ItemMedia" model="media" />
        }
    </sa-item-media>
    <sa-item-content data-lookup="text" class="min-w-0 gap-0">
        <sa-item-title class="w-full text-sm"><span class="truncate" data-lookup="title">@item?.Text</span></sa-item-title>
        @if (!string.IsNullOrEmpty(item?.Description))
        {
            <sa-item-description class="truncate text-xs">@item.Description</sa-item-description>
        }
    </sa-item-content>
}
else if (Model.IsReadOnly)
{
    @if (media is not null)
    {
        <partial name="_ItemMedia" model="media" />
    }
    <span class="min-w-0 truncate">@item?.Text</span>
}
else
{
    <span class="flex shrink-0 items-center" data-lookup="media" hidden="@(media is null)">
        @if (media is not null)
        {
            <partial name="_ItemMedia" model="media" />
        }
    </span>
    <span class="flex min-w-0 items-center" data-lookup="text">
        <span class="truncate" data-lookup="title">@item?.Text</span>
    </span>
}

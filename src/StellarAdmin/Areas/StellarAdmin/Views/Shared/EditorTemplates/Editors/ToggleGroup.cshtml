@inherits FieldEditorView<ToggleGroupEditor>

@* While a field its choices depend on has no value, the group shows why in place of its choices *@
@if (WaitingText is { } waitingText)
{
    <partial name="_WaitingChoiceGroup" model="new WaitingChoiceGroupViewModel(Html.IdForModel(), Html.NameForModel(), Title ?? ViewData.ModelMetadata.GetDisplayName(), Description ?? ViewData.ModelMetadata.Description, waitingText, ViewData.ModelMetadata.ElementMetadata is not null)" />
    return;
}

@{
    var choices = Editor.ResolveChoices(EditorData, ViewData.ModelMetadata, Model);
    var multiple = ViewData.ModelMetadata.ElementMetadata is not null;
    var chips = Editor.Appearance == ToggleGroupAppearance.Chips;
    var joined = Editor.Appearance == ToggleGroupAppearance.Joined;
    var checkClass = Editor.CheckPlacement switch
    {
        ToggleGroupCheckPlacement.ReplaceMedia => "sa-toggle-chips-check-replace",
        ToggleGroupCheckPlacement.End => "sa-toggle-chips-check-end",
        _ => null,
    };
    var appearanceClass = joined ? null : chips ? $"sa-toggle-group-wrap sa-toggle-chips {checkClass}".TrimEnd() : "sa-toggle-group-wrap";
    var emptySelected = ChoiceSelection.SelectsEmptyChoice(Model, ViewData.ModelState[Html.NameForModel()]);
}

<sa-toggle-group class="@appearanceClass" class-names="@EditorClassNamesMapper.ForToggleGroup(Editor)" asp-for="@Model" multiple="@multiple" variant="ToggleVariant.Outline"
                 spacing="@(joined ? ToggleGroupSpacing.None : ToggleGroupSpacing.Default)" label="@Title" description="@Description" readonly="@IsReadOnly">
    @foreach (var choice in choices)
    {
        bool? selected = emptySelected && choice.Value == "" ? true : null;
        var media = ItemMediaViewModel.Create(choice.Media, choice.Title, ItemMediaPlacement.Inline, Editor.ClassNames.Media);
        <sa-toggle-group-item value="@choice.Value" selected="@selected" disabled="@(IsDisabled || choice.Disabled)">
            @if (chips)
            {
                <sa-icon name="check" class="sa-toggle-chip-check" />
            }
            @if (media is not null)
            {
                <partial name="_ItemMedia" model="media" />
            }
            @choice.Title
        </sa-toggle-group-item>
    }
</sa-toggle-group>

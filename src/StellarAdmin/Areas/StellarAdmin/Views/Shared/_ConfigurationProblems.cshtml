@using StellarAdmin.Diagnostics
@model IReadOnlyList<ConfigurationProblem>

@* The configuration problems, which the layout shows in Development: a pill at the bottom of the page that opens a
   sheet listing them, grouped by resource *@
@{
    var count = Model.Count;
    var groups = Model.GroupBy(problem => problem.Resource ?? "Admin panel");
}

<div class="sa-configuration-problems">
    <button type="button" class="sa-configuration-problems-trigger" commandfor="configuration-problems" command="show-modal">
        <span class="sa-configuration-problems-count">@count</span>
        @(count == 1 ? "Configuration problem" : "Configuration problems")
    </button>
</div>

<sa-sheet id="configuration-problems" aria-labelledby="configuration-problems-title" style="width: min(34rem, 100vw); max-width: none">
    <sa-sheet-header>
        <sa-sheet-title id="configuration-problems-title">Configuration problems</sa-sheet-title>
        <sa-sheet-description>The admin panel kept running and worked around these. Fix them before you deploy.</sa-sheet-description>
    </sa-sheet-header>
    <div class="sa-configuration-problems-list">
        @foreach (var group in groups)
        {
            var slug = group.FirstOrDefault(problem => problem.ResourceSlug is not null)?.ResourceSlug;
            var isUnavailable = group.Any(problem => problem.MakesResourceUnavailable);
            <section class="sa-configuration-problems-group">
                <h3 class="sa-configuration-problems-group-title">
                    <span>@(isUnavailable ? $"{group.Key} isn't available" : group.Key)</span>
                    @if (slug is not null && !isUnavailable)
                    {
                        <a asp-area="StellarAdmin" asp-controller="@slug" asp-action="Index">Open</a>
                    }
                </h3>
                @foreach (var problem in group)
                {
                    <div class="sa-configuration-problem">
                        <p class="sa-configuration-problem-message">@problem.Message</p>
                        <p class="sa-configuration-problem-outcome"><strong>Result:</strong> @problem.Outcome</p>
                    </div>
                }
            </section>
        }
    </div>
    <sa-sheet-footer>
        <p class="sa-configuration-problems-footnote">Only Development shows this. Every environment logs each problem once at startup as a warning from <code>StellarAdmin.Configuration</code>.</p>
    </sa-sheet-footer>
</sa-sheet>

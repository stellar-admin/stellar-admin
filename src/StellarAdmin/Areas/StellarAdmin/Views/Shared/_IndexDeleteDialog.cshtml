@model ResourceIndexDeleteDialogViewModel

<sa-alert-dialog id="--delete-confirmation-dialog">
    <sa-alert-dialog-header>
        <sa-alert-dialog-title>@Model.Title</sa-alert-dialog-title>
        <sa-alert-dialog-description>@Model.Message</sa-alert-dialog-description>
    </sa-alert-dialog-header>
    <form method="dialog">
        <sa-alert-dialog-footer>
            <sa-alert-dialog-cancel>@Model.CancelLabel</sa-alert-dialog-cancel>
            <sa-alert-dialog-action
                variant="ButtonVariant.Destructive">@Model.ConfirmLabel</sa-alert-dialog-action>
        </sa-alert-dialog-footer>
    </form>
</sa-alert-dialog>

<script>
    async function confirmResourceDelete() {
        const dialog = window.stellarAdmin.alertDialog("#--delete-confirmation-dialog");
        return await dialog.confirmAsync();
    }
</script>

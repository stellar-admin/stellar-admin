@using StellarAdmin.Resources.Displays
@inherits FieldDisplayView<ImageDisplay>

@{
    var source = await Display.ResolveUrlAsync(Model, Context.RequestServices, Context.RequestAborted);
}

<sa-image variant="ImageVariant.Figure" src="@source" alt="@(ViewData[ViewDataKeys.FieldLabel] as string ?? FieldLabels.Default(ViewData.ModelMetadata))"
          size="Display.Size?.ToImageSize()" aspect-ratio="Display.AspectRatio" fit="Display.Fit"
          interaction="Display.Interaction.ToImageInteraction()" />

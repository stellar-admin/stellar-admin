@inject StellarAdminOptions ProOptions
@inject StellarAdmin.Sidebar.BrandingResolver Branding
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] is string title ? $"{title} - {Branding.Title}" : Branding.Title)</title>
    <meta name="description" content="@Branding.Title">
    <base href="~/"/>
    <script type="importmap"></script>
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="/_content/StellarAdmin.UI/stellar-admin.css" asp-append-version="true"/>
    @foreach (var stylesheet in ProOptions.Stylesheets)
    {
        <link rel="stylesheet" href="@Url.Content(stylesheet)" asp-append-version="true"/>
    }
    <script type="module" src="/_content/StellarAdmin.UI/stellar-admin.js" asp-append-version="true"></script>
    @foreach (var script in ProOptions.Scripts)
    {
        <script defer src="@Url.Content(script)" asp-append-version="true"></script>
    }
</head>
<body>
<sa-sidebar-wrapper>
    <vc:sidebar></vc:sidebar>

    <sa-sidebar-inset>
        <sa-app-header>
            <sa-sidebar-trigger></sa-sidebar-trigger>
            <sa-app-header-separator/>
            <span class="text-sm font-medium">@Branding.Title</span>
        </sa-app-header>
        @RenderBody()
    </sa-sidebar-inset>
</sa-sidebar-wrapper>

@* Toasts queued for the page, and those htmx responses carry in their header *@
<sa-toaster />

@* The sheets stack: a button that opens one adds a level from this template, outside any form, and loads its content
   with htmx; the level is removed again when it closes *@
<template id="admin-sheet-template">
    <partial name="/Areas/StellarAdmin/Views/Shared/_RemoteSheet.cshtml" model="@("admin-sheet")" />
</template>
</body>
</html>

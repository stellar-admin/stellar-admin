@using StellarAdmin.Resources
@model IResourceIndexPageViewModel
@{
    // The widgets' regions, which a search replaces along with the grid. Only the index's own request renders them.
    var widgets = ViewData[ViewDataKeys.Widgets] as PageWidgetsViewModel;
    var widgetRegions = widgets is null
        ? []
        : new[] { (widgets.Top, "#index-page-widgets-top"), (widgets.Aside, "#index-page-widgets-aside"), (widgets.Bottom, "#index-page-widgets-bottom") }
            .Where(region => region.Item1 is not null)
            .Select(region => region.Item2)
            .ToArray();
    var searchOob = string.Join(", ", (Model.Scopes.Count > 0 ? new[] { "#index-page-scopes" } : []).Concat(widgetRegions));
}

<sa-page-container>
    <sa-page-header>
        <sa-page-header-title>@Model.Title</sa-page-header-title>
        <sa-page-header-actions>
            <sa-slot-outlet name="pre-page-actions" />
            @if (Model.CanCreate)
            {
                <sa-button-link asp-action="Create">@Model.CreateLabel</sa-button-link>
            }
            else if (Model.InlineRows?.Create is { AddButton: InlineAddButton.Header or InlineAddButton.Both } inlineCreate)
            {
                @* Adds the new row next to the grid's own Add row when it has one, or else first or last in the grid *@
                var top = inlineCreate.Position == InlineCreatePosition.Top;
                var (addTarget, addSwap) = inlineCreate.AddButton == InlineAddButton.Both
                    ? ("#index-page-grid .sa-table-add-row", top ? "afterend" : "beforebegin")
                    : ("#index-page-grid .sa-table-body", top ? "afterbegin" : "beforeend");
                var query = Model.Query;
                <sa-button data-row-add hx-get="@Url.Action("CreateRow", new { id = (string?)null, page = query.Page is null ? null : Model.Paging?.Page, pageSize = query.PageSize, search = query.Search, scope = query.Scope, sortBy = query.SortBy, sortDirection = query.SortDirection })"
                           hx-target="@addTarget" hx-swap="@addSwap" hx-push-url="false">
                    @Model.CreateLabel
                </sa-button>
            }
            <sa-slot-outlet name="post-page-actions" />
        </sa-page-header-actions>
        @if (Model.Search is not null || Model.Scopes.Count > 0)
        {
            <sa-page-header-nav aria-label="Page sections">
                <sa-group justify="GroupJustify.SpaceBetween" class="my-2 mr-2">
                    @if (Model.Scopes.Count > 0)
                    {
                        <sa-tab-list id="index-page-scopes" hx-boost:inherited="true">
                            @foreach (var scope in Model.Scopes)
                            {
                                <sa-tab-link active="scope.IsActive" asp-action="Index" asp-route-id="@((string?)null)"
                                             asp-route-scope="@scope.QueryValue" asp-route-search="@Model.Query.Search"
                                             asp-route-sortBy="@Model.Query.SortBy" asp-route-sortDirection="@Model.Query.SortDirection"
                                             asp-route-pageSize="@Model.Query.PageSize">
                                    @scope.Title
                                </sa-tab-link>
                            }
                        </sa-tab-list>
                    }
                    @if (Model.Search is { } search)
                    {
                        <sa-input-group id="index-page-search" class="w-full sm:w-64">
                            <sa-input-group-input id="index-page-search-input"
                                                  placeholder="@search.Placeholder"
                                                  aria-label="@search.Placeholder"
                                                  autofocus=""
                                                  value="@search.Term"
                                                  name="search"
                                                  hx-get="@Url.Action("Index", new
                                                          {
                                                              id = (string?)null,
                                                              scope = Model.Query.Scope,
                                                              sortBy = Model.Query.SortBy,
                                                              sortDirection = Model.Query.SortDirection,
                                                              pageSize = Model.Query.PageSize
                                                          })"
                                                  hx-trigger="input changed delay:400ms"
                                                  hx-swap="outerHTML"
                                                  hx-target="#index-page-data-grid"
                                                  hx-select="#index-page-data-grid"
                                                  hx-select-oob="@(searchOob.Length > 0 ? searchOob : null)"
                                                  hx-push-url="true" />
                            <sa-input-group-addon>
                                <sa-icon name="search" />
                            </sa-input-group-addon>
                        </sa-input-group>
                    }
                </sa-group>
            </sa-page-header-nav>
        }
    </sa-page-header>
    @if (widgets?.Top is { } top)
    {
        <div id="index-page-widgets-top" hidden="@(top.Count == 0)">
            <partial name="_Widgets" model="top" />
        </div>
    }
    @if (widgets?.Aside is { } aside)
    {
        @* The grid with a column of widgets beside it, or below it when the page is narrow *@
        <div class="sa-widgets-aside">
            <div class="sa-widgets-aside-grid">
                <partial name="_IndexPageGrid" />
                <div id="index-page-widgets-aside" class="sa-widgets-column" hidden="@(aside.Count == 0)">
                    <partial name="_Widgets" model="aside" />
                </div>
            </div>
        </div>
    }
    else
    {
        <partial name="_IndexPageGrid" />
    }
    @if (widgets?.Bottom is { } bottom)
    {
        <div id="index-page-widgets-bottom" hidden="@(bottom.Count == 0)">
            <partial name="_Widgets" model="bottom" />
        </div>
    }
    @if (Model.Delete is not null)
    {
        <partial name="_IndexDeleteDialog" model="Model.Delete" />
    }
</sa-page-container>

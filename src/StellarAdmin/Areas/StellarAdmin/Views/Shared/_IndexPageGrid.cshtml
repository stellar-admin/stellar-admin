@model IResourceIndexPageViewModel

@* The index page's grid, which its paging, sorting and search replace. A partial data layout takes the grid's place, and
   its links and forms navigate normally instead of swapping the grid *@
<div id="index-page-data-grid"
     hx-boost:inherited="true"
     hx-target:inherited="#index-page-data-grid"
     hx-select:inherited="#index-page-data-grid"
     hx-swap:inherited="outerHTML"
     hx-select-oob:inherited="#index-page-search, #index-page-scopes">
    @Html.ValidationSummary(excludePropertyErrors: true)
    @if (Model.PartialLayout is { } partialLayout)
    {
        <div class="sa-resource-index-partial" hx-boost:inherited="false">
            <partial name="@partialLayout.PartialName" model="partialLayout.Model" />
        </div>
    }
    else if (ViewData[ViewDataKeys.IndexCards] is not null)
    {
        <partial name="_IndexCards" />
    }
    else
    {
        <partial name="_IndexDataGrid" />
    }
</div>

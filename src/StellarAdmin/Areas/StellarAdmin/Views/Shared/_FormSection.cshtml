@inherits FormFieldsBaseView<object>

@{
    var sectionOptions = (FormSectionOptions)ViewData[ViewDataKeys.FormContainer]!;

    // The create sheet is too narrow to split sections, so it stacks them whatever their layout
    var layout = ViewData[ViewDataKeys.SheetLevel] is int
        ? FormSectionLayout.Stacked
        : sectionOptions.Layout ?? ViewData[ViewDataKeys.FormSectionLayout] as FormSectionLayout?;
}

<sa-form-section title="@sectionOptions.Title" description="@sectionOptions.Description" layout="@layout">
    <partial name="_FormItems" model="@Model" />
</sa-form-section>

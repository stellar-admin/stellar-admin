<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateRazorAssemblyInfo>false</GenerateRazorAssemblyInfo>
    <Description>StellarAdmin: integrated admin panel with navigation, resource management and custom pages for ASP.NET Core MVC and Razor Pages</Description>
    <PackageTags>admin;admin-panel;crud;resources</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../StellarAdmin.UI/StellarAdmin.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StellarAdmin.EntityFrameworkCore" />
    <InternalsVisibleTo Include="StellarAdmin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/ComputedValue.cs" Link="Shared/ComputedValue.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <!-- Client -->
  <Import Project="../../build/Client.targets" />

  <ItemGroup>
    <ClientInput Include="Client/css/**/*.css" />
    <ClientInput Include="../StellarAdmin.UI/Client/css/tailwind-adapter.css" />
    <ClientInput Include="Client/js/**/*.js" />
    <ClientInput Include="Client/package.json" />
    <ClientInput Include="Client/scripts/**/*.mjs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Humanizer.Core" />
  </ItemGroup>

  <!-- These items are declared at execution time rather than evaluation time on purpose:
       .cshtml files in a second, custom item type break Rider's Razor analysis for the views,
       and Rider silently strips an evaluation-time ClientOutput item from this file when the
       output file it references is deleted in the IDE. -->
  <Target Name="ClientItems">
    <ItemGroup>
      <ClientInput Include="Areas/**/*.cshtml" />

      <ClientOutput Include="wwwroot/htmx.min.js" />
      <ClientOutput Include="wwwroot/stellar-admin-panel.css" />
      <ClientOutput Include="wwwroot/stellar-admin-panel.js" />
    </ItemGroup>
  </Target>
</Project>

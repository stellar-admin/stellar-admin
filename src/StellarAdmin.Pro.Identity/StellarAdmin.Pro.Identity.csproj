<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateRazorAssemblyInfo>false</GenerateRazorAssemblyInfo>
    <Description>StellarAdmin Pro user and role management screens for ASP.NET Core Identity</Description>
    <PackageTags>admin;crud;identity</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StellarAdmin.TagHelpers\StellarAdmin.TagHelpers.csproj" />
    <ProjectReference Include="..\StellarAdmin.Pro\StellarAdmin.Pro.csproj" />
  </ItemGroup>

  <!-- The views carry no raw Tailwind utility classes - everything visual comes from the
       tag helpers and the StellarAdmin.Pro partials, whose stylesheet ships from
       that package. If a view here ever adds a utility class, this project needs its own
       Client pipeline again (see StellarAdmin.Pro.csproj). -->
</Project>

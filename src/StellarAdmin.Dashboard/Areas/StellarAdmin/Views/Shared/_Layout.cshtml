@inject StellarAdminDashboardOptions ProOptions
@inject Microsoft.Extensions.Options.IOptions<DashboardThemeOptions> ThemeOptions
@inject Microsoft.Extensions.Options.IOptions<ResourceLabelOptions> LabelOptions
@{
    var theme = DashboardThemeCatalog.Get(ThemeOptions.Value.Name);
    var sheetLabels = LabelOptions.Value.Sheet;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>StellarAdmin</title>
    <meta name="description" content="StellarAdmin">
    @await RenderSectionAsync("Styles", required: false)
    @if (ThemeOptions.Value.IncludeSuggestedFonts)
    {
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
        <link rel="stylesheet" href="@($"https://fonts.googleapis.com/css2?family={theme.FontFamilies}&display=swap")"/>
    }
    <link rel="stylesheet" href="@($"/_content/StellarAdmin.TagHelpers/stellar-admin.{theme.Name}.css")" asp-append-version="true"/>
    @foreach (var stylesheet in ProOptions.Stylesheets)
    {
        <link rel="stylesheet" href="@Url.Content(stylesheet)" asp-append-version="true"/>
    }
    <script defer src="/_content/StellarAdmin.TagHelpers/stellar-admin.js" asp-append-version="true"></script>
    @foreach (var script in ProOptions.Scripts)
    {
        <script defer src="@Url.Content(script)" asp-append-version="true"></script>
    }
</head>
<body>
<sa-sidebar-wrapper>
    <vc:sidebar></vc:sidebar>

    <sa-sidebar-inset>
        <sa-app-header>
            <sa-sidebar-trigger></sa-sidebar-trigger>
            <sa-app-header-separator/>
            <span class="text-sm font-medium">StellarAdmin</span>
        </sa-app-header>
        @RenderBody()
    </sa-sidebar-inset>
</sa-sidebar-wrapper>

@* One sheet for the whole page, outside any form; buttons load content into it with htmx, and it shows the loading state again when it closes *@
<dashboard-sheet class="contents">
    <sa-sheet id="dashboard-sheet">
        <div id="dashboard-sheet-content" class="contents">
            <partial name="_SheetLoading" />
        </div>
        <template data-sheet="loading">
            <partial name="_SheetLoading" />
        </template>
        @* Shown by the component when the content fails to load; Retry repeats the request that failed *@
        <template data-sheet="error">
            <sa-empty class="border-0">
                <sa-empty-header>
                    <sa-empty-media variant="EmptyMediaVariant.Icon">
                        <sa-icon name="circle-alert" />
                    </sa-empty-media>
                    <sa-empty-title>@sheetLabels.ErrorTitle</sa-empty-title>
                    <sa-empty-description>@sheetLabels.ErrorDescription</sa-empty-description>
                </sa-empty-header>
                <sa-empty-content>
                    <sa-button type="button" variant="ButtonVariant.Outline" size="ButtonSize.Small" data-sheet="retry">@sheetLabels.RetryLabel</sa-button>
                </sa-empty-content>
            </sa-empty>
        </template>
    </sa-sheet>
</dashboard-sheet>
</body>
</html>

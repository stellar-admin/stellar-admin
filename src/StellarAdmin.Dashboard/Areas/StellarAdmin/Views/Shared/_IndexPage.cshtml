@model IResourceIndexPageViewModel

<sa-page-container>
    <sa-page-header>
        <sa-page-header-title>@Model.Title</sa-page-header-title>
        <sa-page-header-actions>
            <sa-slot-outlet name="pre-page-actions" />
            <sa-linkbutton asp-action="Create">@Model.CreateLabel</sa-linkbutton>
            <sa-slot-outlet name="post-page-actions" />
        </sa-page-header-actions>
    </sa-page-header>
    <div id="index-page-data-grid">
        <partial name="_IndexDataGrid" />
    </div>
</sa-page-container>

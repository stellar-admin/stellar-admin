@model object?

@if (ViewData.ModelMetadata.IsNullableValueType)
{
    @await Html.PartialAsync("EditorTemplates/Editors/Select", Model, ViewData)
}
else
{
    var field = ViewData[ViewDataKeys.FormFieldProperties] as FormFieldProperties;
    var isReadOnly = field?.IsReadOnly == true || ViewData.ModelMetadata.IsReadOnly;

    <sa-input class-names="@EditorClassNamesMapper.ForInput(field?.Editor)" asp-for="@Model" type="checkbox" label="@field?.Title" disabled="@isReadOnly" />
}

@using Microsoft.AspNetCore.Mvc.ModelBinding
@using StellarAdmin.Dashboard.Resources
@inherits FieldEditorView<LookupSheetEditor>
@inject Microsoft.Extensions.Options.IOptions<ResourceLabelOptions> LabelOptions

@{
    var data = (LookupSheetEditorData?)EditorData;
    var item = data?.Item;
    var classes = EditorClassNamesMapper.ForInput(Editor);
    var label = Title ?? ViewData.ModelMetadata.GetDisplayName();
    var canLookUp = !IsReadOnly && Field?.FieldName is not null;
    var allowClear = canLookUp && (Editor.FieldOptions.AllowClear ?? !ViewData.ModelMetadata.IsRequired);
    var isCard = Editor.Layout == LookupSheetEditorLayout.Card;
    var isInvalid = ViewData.ModelState.GetFieldValidationState(Html.NameForModel()) == ModelValidationState.Invalid;
    var selection = new LookupSelectionViewModel(item, Editor.Layout, Editor.FieldOptions.ShowMedia, !canLookUp, Editor.ClassNames.Media);
    var labels = LabelOptions.Value;
    var labelContext = new LookupLabelContext(label, Editor.SheetOptions.MinimumSearchLength, null);
    var chooseText = Editor.FieldOptions.EmptyText ?? labels.Lookup.ChooseLabel(labelContext);
    var clearText = labels.Lookup.ClearLabel(labelContext);
    var noneText = labels.Lookup.NoneText(labelContext);

    // The selection and the empty buttons are both rendered, and the script shows one; the hidden input carries the posted value
    var id = Html.IdForModel();
    var descriptionId = string.IsNullOrEmpty(Description ?? ViewData.ModelMetadata.Description) ? null : $"{id}-description";
    var errorId = $"{id}-error";
    var describedBy = string.Join(' ', new[] { descriptionId, errorId }.OfType<string>());
    // The sheets open as the next level of the stack; a create form in a sheet looks up from its own resource
    var sheetLevel = ViewData[ViewDataKeys.SheetLevel] as int?;
    var form = sheetLevel is not null ? "create" : ViewContext.RouteData.Values["action"]?.ToString()?.ToLowerInvariant();
    var sheetUrl = canLookUp
        ? Url.Action("LookupSheet", new { id = (string?)null, form, field = Field!.FieldName, @for = id })
        : null;
    var createUrl = canLookUp && data?.CreateController is { } createController
        ? Url.Action("CreateSheet", createController, new { id = (string?)null, @for = id, level = (sheetLevel ?? 0) + 1 })
        : null;
    var selectionUrl = createUrl is not null
        ? Url.Action("LookupSelection", new { id = (string?)null, form, field = Field!.FieldName })
        : null;
    var emptyClass = $"w-auto min-w-0 items-stretch overflow-hidden border-dashed p-0 text-sm {(isCard ? "h-12" : "")} {(isInvalid ? "border-destructive text-destructive" : "text-muted-foreground")}";
    var emptyButtonClass = "hover:bg-muted/50 hover:text-foreground flex min-w-0 flex-1 items-center justify-center gap-2 px-3 outline-none transition-colors";
}

<sa-field class="@classes.Root">
    <sa-field-label class="@classes.Label" id="@($"{id}-label")">@label</sa-field-label>

    @* Shows a selection made in a sheet, and clears the value *@
    <dashboard-lookup-sheet-editor class="contents" selection-url="@selectionUrl">
        <input type="hidden" asp-for="@Model" data-lookup="value" />

        @if (!canLookUp)
        {
            @if (item is null)
            {
                @if (isCard)
                {
                    <sa-item variant="ItemVariant.Muted" size="ItemSize.ExtraSmall" class="@($"h-12 {classes.Control}")" aria-describedby="@describedBy">
                        <span class="text-muted-foreground text-sm">@noneText</span>
                    </sa-item>
                }
                else
                {
                    <div class="@($"sa-input flex items-center {classes.Control}")" aria-describedby="@describedBy">
                        <span class="text-muted-foreground">@noneText</span>
                    </div>
                }
            }
            else if (isCard)
            {
                <sa-item variant="ItemVariant.Muted" size="ItemSize.ExtraSmall" class="@($"flex-nowrap {classes.Control}")" aria-describedby="@describedBy">
                    <partial name="_LookupSelection" model="selection" />
                </sa-item>
            }
            else
            {
                <div class="@($"sa-input flex items-center gap-2 {(selection.ShowMedia && item.Media is not null ? "pl-1.5" : "")} {classes.Control}")"
                     aria-describedby="@describedBy">
                    <partial name="_LookupSelection" model="selection" />
                </div>
            }
        }
        else
        {
            var invalidRing = isInvalid ? "border-destructive ring-destructive/20 ring-[3px]" : "";

            @if (isCard)
            {
                <sa-item id="@($"{id}-selected")" data-lookup="selected" variant="ItemVariant.Outline" size="ItemSize.ExtraSmall" hidden="@(item is null)"
                         class="@($"flex-nowrap {invalidRing} {classes.Control}")" role="group" aria-labelledby="@($"{id}-label")"
                         aria-describedby="@describedBy">
                    <partial name="_LookupSelection" model="selection" />
                    <sa-item-actions class="gap-0.5">
                        <sa-button type="button" id="@($"{id}-change")" variant="ButtonVariant.Ghost" size="ButtonSize.ExtraSmall"
                                   data-sheet-open="@sheetUrl" data-lookup="open">
                            @labels.Lookup.ChangeLabel(labelContext)<span class="sr-only"> @label</span>
                        </sa-button>
                        @if (allowClear)
                        {
                            <sa-button type="button" variant="ButtonVariant.Ghost" size="ButtonSize.IconExtraSmall" data-lookup="clear">
                                <sa-icon name="x" />
                                <span class="sr-only">@clearText</span>
                            </sa-button>
                        }
                    </sa-item-actions>
                </sa-item>
            }
            else
            {
                @* The selection is the button that opens the sheet, so each segment of the group has its own focus ring *@
                <sa-button-group id="@($"{id}-selected")" data-lookup="selected" hidden="@(item is null)" class="@($"w-full {classes.Control}")"
                                 aria-labelledby="@($"{id}-label")" aria-describedby="@describedBy">
                    <sa-button type="button" id="@($"{id}-change")" variant="ButtonVariant.Outline"
                               class="@($"min-w-0 flex-1 justify-start font-normal has-[>[data-lookup=media]:not([hidden])]:pl-1.5 {invalidRing}")"
                               aria-invalid="@(isInvalid ? "true" : null)" data-sheet-open="@sheetUrl" data-lookup="open">
                        <span class="sr-only">@labels.Lookup.ChangeLabel(labelContext) @label, </span>
                        <partial name="_LookupSelection" model="selection" />
                        <sa-icon name="chevrons-up-down" class="text-muted-foreground ml-auto size-4 shrink-0" />
                    </sa-button>
                    @if (allowClear)
                    {
                        <sa-button type="button" variant="ButtonVariant.Outline" size="ButtonSize.Icon" data-lookup="clear">
                            <sa-icon name="x" />
                            <span class="sr-only">@clearText</span>
                        </sa-button>
                    }
                </sa-button-group>
            }

            <div id="@($"{id}-empty")" data-lookup="empty" class="flex gap-2" hidden="@(item is not null)">
                <sa-input-group class="@emptyClass">
                    <button type="button" id="@($"{id}-choose")" class="@emptyButtonClass" data-slot="input-group-control"
                            data-sheet-open="@sheetUrl" aria-describedby="@describedBy" data-lookup="open">
                        <sa-icon name="search" class="size-4 shrink-0" />
                        <span class="truncate">@chooseText</span>
                    </button>
                </sa-input-group>
                @if (createUrl is not null)
                {
                    <sa-input-group class="@($"{emptyClass} shrink-0")">
                        <button type="button" id="@($"{id}-create")" class="@emptyButtonClass" data-slot="input-group-control"
                                data-sheet-open="@createUrl" data-lookup="create">
                            <sa-icon name="plus" class="size-4 shrink-0" />
                            <span class="truncate">@labels.Lookup.CreateLabel(labelContext)</span>
                        </button>
                    </sa-input-group>
                }
            </div>
        }
    </dashboard-lookup-sheet-editor>

    <sa-field-error class="@classes.Error" id="@errorId" asp-for="@Model" />
    <sa-field-description class="@classes.Description" id="@descriptionId" asp-for="@Model">@Description</sa-field-description>
</sa-field>

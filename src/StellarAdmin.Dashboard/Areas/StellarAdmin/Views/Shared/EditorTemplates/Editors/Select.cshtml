@inherits FieldEditorView<SelectEditor>

@{
    var items = ChoiceSelectListItems.Create(Editor.ResolveChoices(EditorData, ViewData.ModelMetadata));
}

<sa-select class-names="@EditorClassNamesMapper.ForSelect(Editor)" asp-for="@Model" asp-items="@items"
           label="@Title" description="@Description" disabled="@IsReadOnly" />

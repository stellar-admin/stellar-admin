@using Microsoft.AspNetCore.Mvc.Rendering
@inherits FieldEditorView<RadioGroupEditor>

@{
    var metadata = ViewData.ModelMetadata;
    var choices = Editor.ResolveChoices(EditorData, metadata, Model);
    var classes = EditorClassNamesMapper.ForRadio(Editor);
    var cards = Editor.Appearance == RadioGroupAppearance.Cards;
    var emptyChecked = ChoiceSelection.SelectsEmptyChoice(Model, ViewData.ModelState[Html.NameForModel()]);
}

<sa-field-set class="@classes.Root">
    <sa-field-legend class="@classes.Label" variant="FieldLegendVariant.Label">
        @(Title ?? metadata.DisplayName ?? metadata.PropertyName)
    </sa-field-legend>
    <sa-field-description class="@classes.Description" asp-for="@Model">@Description</sa-field-description>

    <sa-field-group class="@classes.Control" data-slot="radio-group">
        @foreach (var choice in choices)
        {
            var id = TagBuilder.CreateSanitizedId($"{Html.IdForModel()}_{choice.Value}", "_");
            var disabled = IsReadOnly || choice.Disabled;
            var isChecked = emptyChecked && choice.Value == "" ? "checked" : null;
            var media = ItemMediaViewModel.Create(choice.Media, choice.Text, cards ? ItemMediaPlacement.Card : ItemMediaPlacement.Inline, classes.Media);

            if (cards)
            {
                <sa-field-label class="@classes.Option.Root" for="@id">
                    <sa-field orientation="FieldOrientation.Horizontal">
                        @if (media is not null)
                        {
                            <partial name="_ItemMedia" model="media" />
                        }
                        <sa-field-content class="@classes.Option.Content">
                            <sa-field-title class="@classes.Option.Label">@choice.Text</sa-field-title>

                            @if (!string.IsNullOrEmpty(choice.Description))
                            {
                                <sa-field-description class="@classes.Option.Description">@choice.Description</sa-field-description>
                            }
                        </sa-field-content>

                        <sa-input asp-for="@Model" type="radio" value="@choice.Value" id="@id" checked="@isChecked"
                                  disabled="@disabled" render-field="false" class-names="@classes.Option" />
                    </sa-field>
                </sa-field-label>
            }
            else
            {
                <sa-field class="@classes.Option.Root" orientation="FieldOrientation.Horizontal">
                    <sa-input asp-for="@Model" type="radio" value="@choice.Value" id="@id" checked="@isChecked"
                              disabled="@disabled" render-field="false" class-names="@classes.Option" />
                    <sa-field-content class="@classes.Option.Content">
                        <sa-field-label class="@classes.Option.Label" for="@id">
                            @if (media is not null)
                            {
                                <partial name="_ItemMedia" model="media" />
                            }
                            @choice.Text
                        </sa-field-label>

                        @if (!string.IsNullOrEmpty(choice.Description))
                        {
                            <sa-field-description class="@classes.Option.Description">@choice.Description</sa-field-description>
                        }
                    </sa-field-content>
                </sa-field>
            }
        }
    </sa-field-group>

    <sa-field-error class="@classes.Error" asp-for="@Model" />
</sa-field-set>

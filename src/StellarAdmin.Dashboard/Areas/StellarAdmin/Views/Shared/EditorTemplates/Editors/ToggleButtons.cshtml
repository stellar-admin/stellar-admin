@inherits FieldEditorView<ToggleButtonsEditor>

@{
    var choices = Editor.ResolveChoices(EditorData, ViewData.ModelMetadata);
}

<sa-segmented-control class="@EditorClassNamesMapper.ForToggleButtons(Editor)" asp-for="@Model"
                      label="@Title" description="@Description" disabled="@IsReadOnly">
    @foreach (var choice in choices)
    {
        <sa-segmented-control-item value="@choice.Value" disabled="@choice.Disabled">@choice.Text</sa-segmented-control-item>
    }
</sa-segmented-control>

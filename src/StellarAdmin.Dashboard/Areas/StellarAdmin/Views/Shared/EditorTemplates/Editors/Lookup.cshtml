@using Microsoft.AspNetCore.Mvc.ModelBinding
@using StellarAdmin.Dashboard.Resources
@inherits FieldEditorView<LookupEditor>
@inject Microsoft.Extensions.Options.IOptions<ResourceLabelOptions> LabelOptions

@{
    var item = EditorData as LookupItem;
    var classes = EditorClassNamesMapper.ForInput(Editor);
    var label = Title ?? ViewData.ModelMetadata.GetDisplayName();
    var canLookUp = !IsReadOnly && Field?.FieldName is not null;
    var allowClear = canLookUp && (Editor.FieldOptions.AllowClear ?? !ViewData.ModelMetadata.IsRequired);
    var isCard = Editor.Layout == LookupEditorLayout.Card;
    var isInvalid = ViewData.ModelState.GetFieldValidationState(Html.NameForModel()) == ModelValidationState.Invalid;
    var selection = new LookupSelectionViewModel(item, Editor.Layout, Editor.FieldOptions.ShowMedia, !canLookUp);
    var labels = LabelOptions.Value;
    var labelContext = new LookupLabelContext(label, Editor.SheetOptions.MinimumSearchLength, null);
    var chooseText = Editor.FieldOptions.EmptyText ?? labels.LookupChooseLabel(labelContext);
    var clearText = labels.LookupClearLabel(labelContext);
    var noneText = labels.LookupNoneText(labelContext);

    // The selection and the empty buttons are both rendered, and the script shows one; the hidden input carries the posted value
    var id = Html.IdForModel();
    var sheetId = $"{id}-lookup";
    var resultsId = $"{id}-results";
    var descriptionId = string.IsNullOrEmpty(Description ?? ViewData.ModelMetadata.Description) ? null : $"{id}-description";
    var errorId = $"{id}-error";
    var describedBy = string.Join(' ', new[] { descriptionId, errorId }.OfType<string>());
    var lookupUrl = canLookUp
        ? Url.Action("Lookup", new { id = (string?)null, form = ViewContext.RouteData.Values["action"]?.ToString()?.ToLowerInvariant(), field = Field!.FieldName })
        : null;
    var emptyClass = $"w-auto min-w-0 items-stretch overflow-hidden border-dashed p-0 text-sm {(isCard ? "h-12" : "")} {(isInvalid ? "border-destructive text-destructive" : "text-muted-foreground")}";
    var sheetTitle = Editor.SheetOptions.Title ?? label;

    // The loading rows take the shape of the results' media: the Card size with a description, otherwise the Input size
    var skeletonMediaClass = Editor.SheetOptions.ShowMedia
        ? (Editor.Items?.MediaType, Editor.Items?.HasDescription == true) switch
        {
            (LookupMediaType.Code, true) => "size-7 rounded-md",
            (LookupMediaType.Code, false) => "h-5 w-8 rounded-sm",
            (LookupMediaType.Avatar, true) => "size-8 rounded-full",
            (LookupMediaType.Avatar, false) => "size-6 rounded-full",
            _ => null,
        }
        : null;
    var emptyButtonClass = "hover:bg-muted/50 hover:text-foreground flex min-w-0 flex-1 items-center justify-center gap-2 px-3 outline-none transition-colors";
}

<sa-field class="@classes.Root">
    <sa-field-label class="@classes.Label" id="@($"{id}-label")">@label</sa-field-label>

    <input type="hidden" asp-for="@Model" data-lookup="value" />

    @if (!canLookUp)
    {
        @if (item is null)
        {
            @if (isCard)
            {
                <sa-item variant="ItemVariant.Muted" size="ItemSize.ExtraSmall" class="@($"h-12 {classes.Control}")" aria-describedby="@describedBy">
                    <span class="text-muted-foreground text-sm">@noneText</span>
                </sa-item>
            }
            else
            {
                <div class="@($"sa-input flex items-center {classes.Control}")" aria-describedby="@describedBy">
                    <span class="text-muted-foreground">@noneText</span>
                </div>
            }
        }
        else if (isCard)
        {
            <sa-item variant="ItemVariant.Muted" size="ItemSize.ExtraSmall" class="@($"flex-nowrap {classes.Control}")" aria-describedby="@describedBy">
                <partial name="_LookupSelection" model="selection" />
            </sa-item>
        }
        else
        {
            <div class="@($"sa-input flex items-center gap-2 {(selection.ShowMedia && item.Media is not null ? "pl-1.5" : "")} {classes.Control}")"
                 aria-describedby="@describedBy">
                <partial name="_LookupSelection" model="selection" />
            </div>
        }
    }
    else
    {
        var invalidRing = isInvalid ? "border-destructive ring-destructive/20 ring-[3px]" : "";

        @if (isCard)
        {
            <sa-item id="@($"{id}-selected")" variant="ItemVariant.Outline" size="ItemSize.ExtraSmall" hidden="@(item is null)"
                     class="@($"flex-nowrap {invalidRing} {classes.Control}")" role="group" aria-labelledby="@($"{id}-label")"
                     aria-describedby="@describedBy">
                <partial name="_LookupSelection" model="selection" />
                <sa-item-actions class="gap-0.5">
                    <sa-button type="button" id="@($"{id}-change")" variant="ButtonVariant.Ghost" size="ButtonSize.ExtraSmall"
                               commandfor="@sheetId" command="show-modal" data-lookup="open" data-lookup-for="@id">
                        @labels.LookupChangeLabel(labelContext)<span class="sr-only"> @label</span>
                    </sa-button>
                    @if (allowClear)
                    {
                        <sa-button type="button" variant="ButtonVariant.Ghost" size="ButtonSize.IconExtraSmall" data-lookup="clear"
                                   data-lookup-for="@id">
                            <sa-icon name="x" />
                            <span class="sr-only">@clearText</span>
                        </sa-button>
                    }
                </sa-item-actions>
            </sa-item>
        }
        else
        {
            @* The selection is the button that opens the sheet, so each segment of the group has its own focus ring *@
            <sa-button-group id="@($"{id}-selected")" hidden="@(item is null)" class="@($"w-full {classes.Control}")"
                             aria-labelledby="@($"{id}-label")" aria-describedby="@describedBy">
                <sa-button type="button" id="@($"{id}-change")" variant="ButtonVariant.Outline"
                           class="@($"min-w-0 flex-1 justify-start font-normal has-[>[data-lookup=media]:not([hidden])]:pl-1.5 {invalidRing}")"
                           aria-invalid="@(isInvalid ? "true" : null)" commandfor="@sheetId" command="show-modal" data-lookup="open"
                           data-lookup-for="@id">
                    <span class="sr-only">@labels.LookupChangeLabel(labelContext) @label, </span>
                    <partial name="_LookupSelection" model="selection" />
                    <sa-icon name="chevrons-up-down" class="text-muted-foreground ml-auto size-4 shrink-0" />
                </sa-button>
                @if (allowClear)
                {
                    <sa-button type="button" variant="ButtonVariant.Outline" size="ButtonSize.Icon" data-lookup="clear" data-lookup-for="@id">
                        <sa-icon name="x" />
                        <span class="sr-only">@clearText</span>
                    </sa-button>
                }
            </sa-button-group>
        }

        <div id="@($"{id}-empty")" class="flex gap-2" hidden="@(item is not null)">
            <sa-input-group class="@emptyClass">
                <button type="button" id="@($"{id}-choose")" class="@emptyButtonClass" data-slot="input-group-control"
                        commandfor="@sheetId" command="show-modal" aria-describedby="@describedBy" data-lookup="open"
                        data-lookup-for="@id">
                    <sa-icon name="search" class="size-4 shrink-0" />
                    <span class="truncate">@chooseText</span>
                </button>
            </sa-input-group>
            @if (Editor.CreateEnabled)
            {
                <sa-input-group class="@($"{emptyClass} shrink-0")">
                    <button type="button" class="@emptyButtonClass" data-slot="input-group-control" data-lookup="create">
                        <sa-icon name="plus" class="size-4 shrink-0" />
                        <span class="truncate">@labels.LookupCreateLabel(labelContext)</span>
                    </button>
                </sa-input-group>
            }
        </div>
    }

    <sa-field-error class="@classes.Error" id="@errorId" asp-for="@Model" />
    <sa-field-description class="@classes.Description" id="@descriptionId" asp-for="@Model">@Description</sa-field-description>
</sa-field>

@if (canLookUp)
{
    <sa-sheet id="@sheetId" data-lookup="sheet" data-lookup-for="@id">
        <sa-sheet-header>
            <sa-sheet-title>@sheetTitle</sa-sheet-title>
        </sa-sheet-header>

        @* The search input belongs to no form, so it is not posted and Enter does not submit the page *@
        <sa-command id="@($"{id}-command")" filter="CommandFilter.None" class="min-h-0 flex-1 bg-transparent px-6 pb-6">
            <sa-command-input name="term" autofocus="" form="@($"{sheetId}-search")" placeholder="@Editor.SheetOptions.SearchPlaceholder"
                              aria-label="@(Editor.SheetOptions.SearchPlaceholder ?? labels.LookupSearchLabel(labelContext))" data-lookup="search"
                              hx-get="@lookupUrl" hx-target="@($"#{resultsId}")" hx-trigger="input changed delay:300ms, lookup-open" />
            <sa-command-list class="mt-3 max-h-none flex-1" aria-label="@sheetTitle">
                <div id="@resultsId" data-lookup="results"></div>
            </sa-command-list>
        </sa-command>

        @* Shown by the script while a search loads, shaped like the results *@
        <template data-lookup="loading">
            @for (var row = 0; row < 4; row++)
            {
                <div class="sa-command-item pointer-events-none" aria-hidden="true">
                    @if (skeletonMediaClass is not null)
                    {
                        <sa-skeleton class="@($"shrink-0 {skeletonMediaClass}")" />
                    }
                    <div class="flex flex-1 flex-col gap-1.5">
                        <sa-skeleton class="h-3.5 w-2/5" />
                        @if (Editor.Items!.HasDescription)
                        {
                            <sa-skeleton class="h-3 w-3/5" />
                        }
                    </div>
                </div>
            }
        </template>

        <template data-lookup="error">
            <sa-empty class="border-0 p-4" data-lookup="message">
                <sa-empty-header>
                    <sa-empty-media variant="EmptyMediaVariant.Icon">
                        <sa-icon name="circle-alert" />
                    </sa-empty-media>
                    <sa-empty-title>@labels.LookupErrorTitle(labelContext)</sa-empty-title>
                    <sa-empty-description>@labels.LookupErrorDescription(labelContext)</sa-empty-description>
                </sa-empty-header>
                <sa-empty-content>
                    <sa-button type="button" variant="ButtonVariant.Outline" size="ButtonSize.Small" data-lookup="retry">@labels.LookupRetryLabel(labelContext)</sa-button>
                </sa-empty-content>
            </sa-empty>
        </template>
    </sa-sheet>
}

@inherits FieldEditorView<CheckboxGroupEditor>

@{
    var choices = Editor.ResolveChoices(EditorData, ViewData.ModelMetadata, Model);
    var variant = Editor.Appearance == CheckboxGroupAppearance.Cards ? CheckboxGroupVariant.ChoiceCard : CheckboxGroupVariant.Default;
    var down = Editor.Flow == CheckboxGroupFlow.Down;
    var columns = Editor.ColumnDefinitions?.Resolve();
    var style = columns is { } tiers ? ChoiceColumnsStyle.Format(tiers, choices.Count, down) : null;
    // Razor renders a null data attribute as empty, so the columns are marked with classes
    var columnsClass = columns is null ? null : down ? "sa-choice-columns sa-choice-columns-down" : "sa-choice-columns";
    var classes = string.Join(' ', new[] { EditorClassNamesMapper.ForCheckboxGroup(Editor), columnsClass }.Where(css => css is not null));
    var placement = variant == CheckboxGroupVariant.ChoiceCard ? ItemMediaPlacement.Card : ItemMediaPlacement.Inline;
}

<sa-checkbox-group class="@classes" asp-for="@Model"
                   label="@Title" description="@Description" disabled="@IsReadOnly" variant="@variant"
                   style="@style">
    @foreach (var choice in choices)
    {
        var media = ItemMediaViewModel.Create(choice.Media, choice.Text, placement, Editor.ClassNames.Media);

        // A bound empty description still renders its paragraph, so the attribute is left out instead
        if (string.IsNullOrEmpty(choice.Description))
        {
            <sa-checkbox-group-item value="@choice.Value" disabled="@choice.Disabled">
                @if (media is not null)
                {
                    <sa-checkbox-group-item-media><partial name="_ItemMedia" model="media" /></sa-checkbox-group-item-media>
                }
                @choice.Text
            </sa-checkbox-group-item>
        }
        else
        {
            <sa-checkbox-group-item value="@choice.Value" description="@choice.Description" disabled="@choice.Disabled">
                @if (media is not null)
                {
                    <sa-checkbox-group-item-media><partial name="_ItemMedia" model="media" /></sa-checkbox-group-item-media>
                }
                @choice.Text
            </sa-checkbox-group-item>
        }
    }
</sa-checkbox-group>

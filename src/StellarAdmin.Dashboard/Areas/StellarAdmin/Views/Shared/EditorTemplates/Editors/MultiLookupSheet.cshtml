@using Microsoft.AspNetCore.Mvc.ModelBinding
@using StellarAdmin.Dashboard.Resources
@inherits FieldEditorView<MultiLookupSheetEditor>
@inject Microsoft.Extensions.Options.IOptions<ResourceLabelOptions> LabelOptions

@{
    var items = ((MultiLookupSheetEditorData?)EditorData)?.Items ?? [];
    var classes = EditorClassNamesMapper.ForInput(Editor);
    var label = Title ?? ViewData.ModelMetadata.GetDisplayName();
    var options = Editor.FieldOptions;
    // A read-only summary would hide the names it truncates with nothing to open, so it shows a list
    var layout = IsReadOnly && options.Layout == MultiLookupSheetEditorLayout.Summary ? MultiLookupSheetEditorLayout.List : options.Layout;
    var isInvalid = ViewData.ModelState.GetFieldValidationState(Html.NameForModel()) == ModelValidationState.Invalid;
    var labels = LabelOptions.Value;
    var labelContext = new LookupLabelContext(label, Editor.SheetOptions.MinimumSearchLength, null);
    var chooseText = options.EmptyText ?? labels.Lookup.ChooseLabel(labelContext);
    var addText = labels.Lookup.AddLabel(labelContext);

    var id = Html.IdForModel();
    var name = Html.NameForModel();
    var descriptionId = string.IsNullOrEmpty(Description ?? ViewData.ModelMetadata.Description) ? null : $"{id}-description";
    var errorId = $"{id}-error";
    var describedBy = string.Join(' ', new[] { descriptionId, errorId }.OfType<string>());
    // The sheet opens as the next level of the stack, and its create form above that; a create form in a sheet looks up
    // from its own resource
    var sheetLevel = ViewData[ViewDataKeys.SheetLevel] as int?;
    var form = sheetLevel is not null ? "create" : ViewContext.RouteData.Values["action"]?.ToString()?.ToLowerInvariant();
    var canLookUp = Field?.FieldName is not null;
    var sheetUrl = canLookUp
        ? Url.Action("LookupSheet", new { id = (string?)null, form, field = Field!.FieldName, @for = id, level = sheetLevel })
        : null;
    var selectionUrl = canLookUp
        ? Url.Action("MultiLookupSelection", new { id = (string?)null, form, field = Field!.FieldName })
        : null;
    var editableItems = new MultiLookupItemsViewModel(Editor, items, label);
    var invalidRing = isInvalid ? "border-destructive ring-destructive/20 ring-[3px]" : "";
    var emptyClass = $"w-auto min-w-0 items-stretch overflow-hidden border-dashed p-0 text-sm {(isInvalid ? "border-destructive text-destructive" : "text-muted-foreground")}";
    var emptyButtonClass = "hover:bg-muted/50 hover:text-foreground flex min-w-0 flex-1 items-center justify-center gap-2 px-3 outline-none transition-colors";
    var hasMedia = options.ShowMedia && Editor.Items?.MediaType is not null;

    ItemMediaViewModel? Media(ChoiceItem item, ItemMediaPlacement placement) =>
        options.ShowMedia ? ItemMediaViewModel.Create(item.Media, item.Text, placement, Editor.ClassNames.Media) : null;
}

<sa-field class="@classes.Root">
    <sa-field-label class="@classes.Label" id="@($"{id}-label")">@label</sa-field-label>

    @if (IsReadOnly)
    {
        @if (items.Count == 0)
        {
            <div class="@($"sa-input flex items-center {classes.Control}")" aria-describedby="@describedBy">
                <span class="text-muted-foreground">@labels.Lookup.NoneText(labelContext)</span>
            </div>
        }
        else if (layout == MultiLookupSheetEditorLayout.Chips)
        {
            <sa-chip-group class="@classes.Control" role="list" aria-labelledby="@($"{id}-label")" aria-describedby="@describedBy">
                @foreach (var item in items)
                {
                    var media = Media(item, ItemMediaPlacement.Chip);
                    <sa-chip role="listitem">
                        @if (media is not null)
                        {
                            <partial name="_ItemMedia" model="media" />
                        }
                        @item.Text
                    </sa-chip>
                }
            </sa-chip-group>
        }
        else
        {
            <div class="@($"flex flex-col gap-1.5 {classes.Control}")" role="list" aria-labelledby="@($"{id}-label")" aria-describedby="@describedBy">
                @foreach (var item in items)
                {
                    <partial name="_MultiLookupListItem" model="new MultiLookupListItemViewModel(item, Media(item, ItemMediaPlacement.LookupLarge), null)" />
                }
            </div>
        }
    }
    else
    {
        @* Items selected in the sheet and removed in the field edit the hidden inputs, and the server renders the items
           again from the values. The marker posts an empty selection, which binds an empty collection. *@
        <dashboard-multi-lookup-sheet-editor id="@id" class="contents" name="@name" selection-url="@selectionUrl">
            <input type="hidden" name="@($"__sa_checkbox_group.{name}")" value="true" />
            <div data-lookup="values" hidden>
                @foreach (var item in items)
                {
                    <input type="hidden" name="@name" value="@item.Value" />
                }
            </div>

            @switch (layout)
            {
                case MultiLookupSheetEditorLayout.List:
                    <div id="@($"{id}-selected")" data-lookup="selected" class="@($"flex flex-col gap-1.5 {classes.Control}")" hidden="@(items.Count == 0)">
                        <div class="flex flex-col gap-1.5" role="list" aria-labelledby="@($"{id}-label")" aria-describedby="@describedBy" data-lookup="items">
                            <partial name="_MultiLookupItems" model="editableItems" />
                        </div>
                        <sa-input-group class="@emptyClass">
                            <button type="button" id="@($"{id}-add")" class="@emptyButtonClass" data-slot="input-group-control" data-sheet-open="@sheetUrl" data-lookup="open">
                                <sa-icon name="plus" class="size-4 shrink-0" />
                                <span class="truncate">@addText</span>
                            </button>
                        </sa-input-group>
                    </div>
                    <div id="@($"{id}-empty")" data-lookup="empty" class="flex gap-2" hidden="@(items.Count > 0)">
                        <sa-input-group class="@($"h-12 {emptyClass} flex-1 {classes.Control}")">
                            <button type="button" id="@($"{id}-choose")" class="@emptyButtonClass" data-slot="input-group-control"
                                    aria-describedby="@describedBy" data-sheet-open="@sheetUrl" data-lookup="open">
                                <sa-icon name="search" class="size-4 shrink-0" />
                                <span class="truncate">@chooseText</span>
                            </button>
                        </sa-input-group>
                    </div>
                    break;

                case MultiLookupSheetEditorLayout.Chips:
                    <sa-chip-group id="@($"{id}-selected")" data-lookup="selected" hidden="@(items.Count == 0)"
                                   appearance="ChipGroupAppearance.Input" invalid="isInvalid" class="@classes.Control"
                                   aria-labelledby="@($"{id}-label")" aria-describedby="@describedBy">
                        <span class="contents" data-lookup="items">
                            <partial name="_MultiLookupItems" model="editableItems" />
                        </span>
                        <sa-button type="button" id="@($"{id}-add")" variant="ButtonVariant.Ghost" size="ButtonSize.ExtraSmall"
                                   class="text-muted-foreground hover:text-foreground min-w-0" data-sheet-open="@sheetUrl" data-lookup="open">
                            <sa-icon name="plus" />
                            <span class="truncate">@addText</span>
                        </sa-button>
                    </sa-chip-group>
                    @* Empty, the box stays an input: the hint and the chevrons, like a select *@
                    <sa-input-group id="@($"{id}-empty")" data-lookup="empty" hidden="@(items.Count > 0)"
                                    class="@($"h-9 min-w-0 items-stretch p-0 {invalidRing} {classes.Control}")">
                        <button type="button" id="@($"{id}-choose")" data-slot="input-group-control" aria-describedby="@describedBy" data-sheet-open="@sheetUrl" data-lookup="open"
                                aria-invalid="@(isInvalid ? "true" : null)"
                                class="text-muted-foreground flex min-w-0 flex-1 items-center justify-between gap-2 px-3 text-sm outline-none">
                            <span class="truncate">@chooseText</span>
                            <sa-icon name="chevrons-up-down" class="size-4 shrink-0 opacity-60" />
                        </button>
                    </sa-input-group>
                    break;

                default:
                    @* The summary is the button that opens the sheet, so each segment of the group has its own focus ring *@
                    <sa-button-group id="@($"{id}-selected")" data-lookup="selected" hidden="@(items.Count == 0)" class="@($"w-full {classes.Control}")"
                                     aria-labelledby="@($"{id}-label")" aria-describedby="@describedBy">
                        <sa-button type="button" id="@($"{id}-change")" variant="ButtonVariant.Outline"
                                   class="@($"min-w-0 flex-1 justify-start font-normal {(hasMedia ? "pl-1.5" : "")} {invalidRing}")"
                                   aria-invalid="@(isInvalid ? "true" : null)" data-sheet-open="@sheetUrl" data-lookup="open">
                            <span class="contents" data-lookup="items">
                                <partial name="_MultiLookupItems" model="editableItems" />
                            </span>
                            <sa-icon name="chevrons-up-down" class="text-muted-foreground size-4 shrink-0" />
                        </sa-button>
                        <sa-button type="button" variant="ButtonVariant.Outline" size="ButtonSize.Icon" data-lookup="clear">
                            <sa-icon name="x" />
                            <span class="sr-only">@labels.Lookup.ClearLabel(labelContext)</span>
                        </sa-button>
                    </sa-button-group>
                    <div id="@($"{id}-empty")" data-lookup="empty" class="flex gap-2" hidden="@(items.Count > 0)">
                        <sa-input-group class="@($"{emptyClass} flex-1 {classes.Control}")">
                            <button type="button" id="@($"{id}-choose")" class="@emptyButtonClass" data-slot="input-group-control"
                                    aria-describedby="@describedBy" data-sheet-open="@sheetUrl" data-lookup="open">
                                <sa-icon name="search" class="size-4 shrink-0" />
                                <span class="truncate">@chooseText</span>
                            </button>
                        </sa-input-group>
                    </div>
                    break;
            }
        </dashboard-multi-lookup-sheet-editor>
    }

    <sa-field-error class="@classes.Error" id="@errorId" asp-for="@Model" />
    <sa-field-description class="@classes.Description" id="@descriptionId" asp-for="@Model">@Description</sa-field-description>
</sa-field>

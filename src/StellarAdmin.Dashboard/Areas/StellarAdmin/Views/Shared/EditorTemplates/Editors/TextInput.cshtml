@model object?

@{
    var field = ViewData[ViewDataKeys.FormFieldProperties] as FormFieldProperties;
    var metadata = ViewData.ModelMetadata;
    var isReadOnly = field?.IsReadOnly == true || metadata.IsReadOnly;
    var modelType = metadata.UnderlyingOrModelType;
    var type = metadata.DataTypeName switch
    {
        "EmailAddress" => "email",
        "PhoneNumber" => "tel",
        "Url" => "url",
        "Password" => "password",
        _ when modelType == typeof(decimal) || modelType == typeof(double) || modelType == typeof(float) => "number",
        _ when modelType.IsPrimitive && modelType != typeof(bool) && modelType != typeof(char) => "number",
        _ => null,
    };
    var step = type != "number" ? null : modelType == typeof(decimal) || modelType == typeof(double) || modelType == typeof(float) ? "any" : "1";
}

<sa-input class-names="@EditorClassNamesMapper.ForInput(field?.Editor)" asp-for="@Model" type="@type" step="@step"
          label="@field?.Title" readonly="@isReadOnly" data-spike-editor="text-input" />

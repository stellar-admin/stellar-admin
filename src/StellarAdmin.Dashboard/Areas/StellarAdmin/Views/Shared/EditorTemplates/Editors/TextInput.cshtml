@inherits FieldEditorView<TextInputEditor>

@{
    var attributes = Editor.ResolveAttributes(ViewData.ModelMetadata);
    var classes = EditorClassNamesMapper.ForInput(Editor);
}

@if (Editor.Prefix is null && Editor.Suffix is null)
{
    <sa-input class-names="@classes" asp-for="@Model" type="@attributes.Type" step="@attributes.Step" min="@attributes.Min" max="@attributes.Max"
              placeholder="@Editor.Placeholder" label="@Title" readonly="@IsReadOnly" />
}
else
{
    // The input group has no field wrapper of its own, so the field parts are composed here
    var id = Html.IdForModel();
    var descriptionId = string.IsNullOrEmpty(ViewData.ModelMetadata.Description) ? null : $"{id}-description";
    var errorId = $"{id}-error";

    <sa-field class="@classes.Root">
        <sa-field-label class="@classes.Label" asp-for="@Model">@Title</sa-field-label>

        <sa-input-group class="@classes.Control">
            @if (Editor.Prefix is not null)
            {
                <sa-input-group-addon>
                    <sa-input-group-text>@Editor.Prefix</sa-input-group-text>
                </sa-input-group-addon>
            }

            <sa-input-group-input asp-for="@Model" type="@attributes.Type" step="@attributes.Step" min="@attributes.Min" max="@attributes.Max"
                                  placeholder="@Editor.Placeholder" readonly="@IsReadOnly"
                                  aria-describedby="@(descriptionId is null ? errorId : $"{descriptionId} {errorId}")" />

            @if (Editor.Suffix is not null)
            {
                <sa-input-group-addon align="InputGroupAddOnVariantAlignment.InlineEnd">
                    <sa-input-group-text>@Editor.Suffix</sa-input-group-text>
                </sa-input-group-addon>
            }
        </sa-input-group>

        <sa-field-description class="@classes.Description" id="@descriptionId" asp-for="@Model" />
        <sa-field-error class="@classes.Error" id="@errorId" asp-for="@Model" />
    </sa-field>
}

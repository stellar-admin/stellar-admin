@using Microsoft.AspNetCore.Mvc.Rendering
@model object?

@{
    var field = ViewData[ViewDataKeys.FormFieldProperties] as FormFieldProperties;
    var isReadOnly = field?.IsReadOnly == true || ViewData.ModelMetadata.IsReadOnly;
}

<sa-checkbox-group class="@EditorClassNamesMapper.ForCheckboxGroup(field?.Editor)" asp-for="@Model" asp-items="@(field?.EditorData as IReadOnlyList<SelectListItem>)"
                   label="@field?.Title" disabled="@isReadOnly" />

@model object?

@{
    var field = ViewData[ViewDataKeys.FormFieldProperties] as FormFieldProperties;
    var metadata = ViewData.ModelMetadata;
    var isReadOnly = field?.IsReadOnly == true || metadata.IsReadOnly;
}

@if (metadata.IsFlagsEnum)
{
    <sa-input class-names="@EditorClassNamesMapper.ForInput(field?.Editor)" asp-for="@Model" type="text" label="@field?.Title" readonly="@isReadOnly" />
}
else
{
    <sa-select class-names="@EditorClassNamesMapper.ForSelect(field?.Editor)" asp-for="@Model" asp-items="@Html.GetEnumSelectList(metadata.UnderlyingOrModelType)"
               label="@field?.Title" disabled="@isReadOnly">
        @if (metadata.IsNullableValueType)
        {
            <option value="">Not set</option>
        }
    </sa-select>
}

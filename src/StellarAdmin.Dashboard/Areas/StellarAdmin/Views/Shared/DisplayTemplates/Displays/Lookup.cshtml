@using StellarAdmin.Dashboard.Resources.Displays
@using StellarAdmin.Dashboard.Resources.Editors
@inherits FieldDisplayView<LookupDisplay>

@* The handler resolves the items, and a value it doesn't find shows the value *@
@if (DisplayData is IReadOnlyList<ChoiceItem> items)
{
    @string.Join(", ", items.Select(item => item.Text))
}
else
{
    @Model
}

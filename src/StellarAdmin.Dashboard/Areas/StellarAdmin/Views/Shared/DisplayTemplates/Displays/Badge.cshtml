@using System.Collections
@using System.Globalization
@using StellarAdmin.Dashboard.Resources.Displays
@inherits FieldDisplayView<BadgeDisplay>

@{
    var metadata = ViewData.ModelMetadata;
    var items = Model is IEnumerable values and not string ? values.Cast<object?>() : [Model];
    var itemMetadata = Model is IEnumerable and not string ? metadata.ElementMetadata ?? metadata : metadata;
}

@* A collection shows a badge for each item *@
@foreach (var item in items)
{
    <sa-badge variant="@Display.Variant">@FormatItem(item, itemMetadata)</sa-badge>
}

@functions {
    // Enum members show their [Display] names, as the display field does
    private static string FormatItem(object? item, Microsoft.AspNetCore.Mvc.ModelBinding.ModelMetadata metadata)
    {
        if (item is Enum value && metadata.IsEnum)
        {
            var numericValue = value.ToString("D");
            foreach (var (groupAndName, enumValue) in metadata.EnumGroupedDisplayNamesAndValues!)
            {
                if (enumValue == numericValue)
                {
                    return groupAndName.Name;
                }
            }
        }

        return metadata.DisplayFormatString is { } format
            ? string.Format(CultureInfo.CurrentCulture, format, item)
            : Convert.ToString(item, CultureInfo.CurrentCulture) ?? "";
    }
}

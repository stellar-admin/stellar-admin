@using System.ComponentModel.DataAnnotations
@using StellarAdmin.Dashboard.Resources.Displays
@inherits FieldDisplayView<TextDisplay>

@{
    var multiline = ViewData.ModelMetadata.DataTypeName == nameof(DataType.MultilineText) ? "true" : "false";
}

@* Razor writes data attributes even when null, so a clamped value renders its own element *@
@if (Display.LineClamp is { } lineClamp)
{
    <span class="sa-text-display" data-multiline="@multiline" data-line-clamp="@lineClamp" style="--_line-clamp:@lineClamp">@FormatValue()</span>
}
else
{
    <span class="sa-text-display" data-multiline="@multiline">@FormatValue()</span>
}

@model LookupSheetViewModel
@inject Microsoft.Extensions.Options.IOptions<ResourceLabelOptions> LabelOptions

@{
    var editor = Model.Editor;
    var labels = LabelOptions.Value;
    var multiple = editor is MultiLookupSheetEditor;

    // The loading rows take the shape of the results' media: the Card size with a description, otherwise the Input size
    var skeletonMediaClass = editor.SheetOptions.ShowMedia
        ? (editor.Items!.MediaType, editor.Items.HasDescription) switch
        {
            ({ } type, true) when type == typeof(ItemMedia.Code) => "size-7 rounded-md",
            ({ } type, false) when type == typeof(ItemMedia.Code) => "h-5 w-8 rounded-sm",
            ({ } type, true) when type == typeof(ItemMedia.Avatar) => "size-8 rounded-full",
            ({ } type, false) when type == typeof(ItemMedia.Avatar) => "size-6 rounded-full",
            ({ } type, true) when type == typeof(ItemMedia.Image) => "size-8 rounded-md",
            ({ } type, false) when type == typeof(ItemMedia.Image) => "size-6 rounded-sm",
            ({ } type, true) when type == typeof(ItemMedia.Icon) => "size-5 rounded-sm",
            ({ } type, false) when type == typeof(ItemMedia.Icon) => "size-4 rounded-sm",
            _ => null,
        }
        : null;

    // Shown in the results until they arrive, and again when a failed search is retried
    async Task LoadingRows()
    {
        for (var row = 0; row < 4; row++)
        {
            <div class="sa-command-item pointer-events-none" aria-hidden="true">
                @if (skeletonMediaClass is not null)
                {
                    <sa-skeleton class="@($"shrink-0 {skeletonMediaClass}")" />
                }
                <div class="flex flex-1 flex-col gap-1.5">
                    <sa-skeleton class="h-3.5 w-2/5" />
                    @if (editor.Items!.HasDescription)
                    {
                        <sa-skeleton class="h-3 w-3/5" />
                    }
                </div>
            </div>
        }
    }
}

@* The lookup picker loaded into a sheet; for names the editor that results belong to. A multi-select picker can show
   only the selected items, and its footer closes the sheet. *@
<dashboard-lookup-picker class="contents" for="@Model.For" multiple="@multiple">
    <sa-sheet-header>
        <sa-sheet-title>@Model.Title</sa-sheet-title>
    </sa-sheet-header>

    <sa-command filter="CommandFilter.None" class="@($"min-h-0 flex-1 bg-transparent px-6 {(multiple ? "pb-3" : "pb-6")}")">
        <sa-command-input name="term" autofocus="" placeholder="@editor.SheetOptions.SearchPlaceholder"
                          aria-label="@(editor.SheetOptions.SearchPlaceholder ?? labels.Lookup.SearchLabel(Model.Labels))" data-lookup="search"
                          hx-get="@Model.ResultsUrl" hx-target="@($"#{Model.For}-results")" hx-trigger="load, input changed delay:300ms, lookup-retry" />
        @if (multiple)
        {
            @* The picker sets the count and the disabled states from the editor's values *@
            <div class="mt-3 flex items-center justify-between gap-3">
                <sa-segmented-control name="@($"{Model.For}-view")" value="all" aria-label="@labels.Lookup.ViewLabel(Model.Labels)">
                    <sa-segmented-control-item value="all" data-lookup="view">@labels.Lookup.AllLabel(Model.Labels)</sa-segmented-control-item>
                    <sa-segmented-control-item value="selected" data-lookup="view">
                        @labels.Lookup.SelectedLabel(Model.Labels)
                        <sa-badge variant="BadgeVariant.Secondary" class="h-5 min-w-5 px-1.5 tabular-nums" data-lookup="count">0</sa-badge>
                    </sa-segmented-control-item>
                </sa-segmented-control>
                <sa-button type="button" variant="ButtonVariant.Ghost" size="ButtonSize.Small" hidden data-lookup="clear-all">@labels.Lookup.ClearAllLabel(Model.Labels)</sa-button>
            </div>
        }
        <sa-command-list class="mt-3 max-h-none flex-1" aria-label="@Model.Title">
            @* The loading rows show until the first results arrive *@
            <div id="@($"{Model.For}-results")" data-lookup="results">
                @{ await LoadingRows(); }
            </div>
        </sa-command-list>
    </sa-command>

    @if (multiple)
    {
        <sa-sheet-footer class="gap-3 border-t">
            <div class="text-muted-foreground hidden items-center gap-1 text-xs sm:flex" aria-hidden="true">
                <sa-kbd>↵</sa-kbd> @labels.Lookup.ToggleHint(Model.Labels)
                <sa-kbd-group class="ml-2" data-lookup="done-key"><sa-kbd>Ctrl</sa-kbd><sa-kbd>↵</sa-kbd></sa-kbd-group> @labels.Lookup.DoneHint(Model.Labels)
            </div>
            <div class="flex gap-2">
                <sa-button type="button" class="flex-1" aria-keyshortcuts="Control+Enter" data-lookup="done">@labels.Lookup.DoneLabel(Model.Labels)</sa-button>
            </div>
        </sa-sheet-footer>
    }

    <template data-lookup="loading">
        @{ await LoadingRows(); }
    </template>

    @* Shown by the picker when a search or Load more fails *@
    <template data-lookup="error">
        <sa-empty class="border-0 p-4" data-lookup="message">
            <sa-empty-header>
                <sa-empty-media variant="EmptyMediaVariant.Icon">
                    <sa-icon name="circle-alert" />
                </sa-empty-media>
                <sa-empty-title>@labels.Lookup.ErrorTitle(Model.Labels)</sa-empty-title>
                <sa-empty-description>@labels.Lookup.ErrorDescription(Model.Labels)</sa-empty-description>
            </sa-empty-header>
            <sa-empty-content>
                <sa-button type="button" variant="ButtonVariant.Outline" size="ButtonSize.Small" data-lookup="retry">@labels.Lookup.RetryLabel(Model.Labels)</sa-button>
            </sa-empty-content>
        </sa-empty>
    </template>
</dashboard-lookup-picker>

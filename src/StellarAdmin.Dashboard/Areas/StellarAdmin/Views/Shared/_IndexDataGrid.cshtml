@model IResourceIndexPageViewModel

<sa-data-grid items="Model.Items">
    @foreach (var column in Model.Columns)
    {
        <sa-data-grid-column title="@column.Title" field-for="@column.FieldExpression"
                             format="@column.Format" sortable="false" />
    }
    @if (Model.CanEdit || Model.Delete is not null)
    {
        <sa-data-grid-column sortable="false" class="w-px whitespace-nowrap">
            <sa-data-grid-item-template>
                @{
                    var resourceId = Model.GetKey(Html.GridItem<object>());
                    var deleteTooltipId = $"--resource-delete-{resourceId}";
                    var editTooltipId = $"--resource-edit-{resourceId}";
                }
                @if (Model.CanEdit)
                {
                    <sa-linkbutton variant="ButtonVariant.Outline" size="ButtonSize.IconSmall"
                                   asp-action="Edit" asp-route-id="@resourceId"
                                   aria-label="@Model.EditLabel" interestfor="@editTooltipId">
                        <sa-icon name="square-pen" />
                    </sa-linkbutton>
                    <sa-tooltip id="@editTooltipId">@Model.EditLabel</sa-tooltip>
                }
                @if (Model.Delete is not null)
                {
                    <form method="post" asp-action="Delete" asp-route-id="@resourceId" class="inline-block" data-resource-delete>
                        <sa-button type="submit" variant="ButtonVariant.Outline" size="ButtonSize.IconSmall"
                                   aria-label="@Model.DeleteLabel" interestfor="@deleteTooltipId">
                            <sa-icon name="trash" />
                        </sa-button>
                    </form>
                    <sa-tooltip id="@deleteTooltipId">@Model.DeleteLabel</sa-tooltip>
                }
            </sa-data-grid-item-template>
        </sa-data-grid-column>
    }
    <sa-data-grid-empty>
        <sa-empty>
            <sa-empty-header>
                <sa-empty-media variant="EmptyMediaVariant.Icon">
                    <sa-icon name="inbox" />
                </sa-empty-media>
                <sa-empty-title>No records found</sa-empty-title>
            </sa-empty-header>
        </sa-empty>
    </sa-data-grid-empty>
</sa-data-grid>
